        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⇧</kbd> + arrastrar un punto o tirador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⇧</kbd> + glisser un point ou une poignée"
