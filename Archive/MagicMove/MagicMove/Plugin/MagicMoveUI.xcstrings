    "The on-screen control turns it in <accent>object</accent> space, so the clip spins with its own content.": {
      "comment": "Magic Move help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmsteuerung dreht ihn im <accent>Objekt</accent>-Raum, sodass der Clip mit seinem eigenen Inhalt rotiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control en pantalla lo gira en el espacio de <accent>objeto</accent>, así que el clip gira con su propio contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande à l'écran le fait tourner dans l'espace <accent>objet</accent>, si bien que le clip pivote avec son propre contenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のコントロールは<accent>オブジェクト</accent>空間で回すので、クリップは自分の内容ごと回転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤은 <accent>오브젝트</accent> 공간에서 돌리므로 클립이 자기 내용과 함께 회전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕控件在<accent>对象</accent>空间中旋转它，因此片段连同自身内容一起转动。"
          }
        }
      }
    },
