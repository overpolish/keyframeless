      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie <kbd>⌥</kbd> gedrückt und bewegen Sie den Zeiger über die Steuerelemente, um das <accent>ausgeblendete</accent> kurz einzublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén <kbd>⌥</kbd> y mueve el cursor sobre los controles para <accent>ver</accent> el oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez <kbd>⌥</kbd> et déplacez le curseur sur les commandes pour <accent>entrevoir</accent> celle qui est masquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌥</kbd>を押しながらコントロールの上で動かすと、<accent>非表示</accent>のコントロールを一時的に確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌥</kbd>를 누른 채 컨트롤 위에서 움직이면 <accent>숨긴</accent> 컨트롤을 잠깐 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住<kbd>⌥</kbd>并在控件上移动，即可<accent>预览</accent>隐藏的控件。"
          }
        }
      }
    },
    "Hold <kbd>⌥</kbd> and move to reveal the control you hid. <warn>Release ⌥</warn> to continue.": {
      "comment": "OSC guide: opt-peek a hidden control.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie <kbd>⌥</kbd> gedrückt und bewegen Sie den Zeiger, um das ausgeblendete Steuerelement einzublenden. <warn>⌥ loslassen</warn>, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén <kbd>⌥</kbd> y mueve el cursor para revelar el control oculto. <warn>Suelta ⌥</warn> para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez <kbd>⌥</kbd> et déplacez le curseur pour révéler la commande masquée. <warn>Relâchez ⌥</warn> pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌥</kbd>を押しながら動かして、非表示にしたコントロールを表示します。<warn>⌥を離す</warn>と続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌥</kbd>를 누른 채 움직여 숨긴 컨트롤을 표시합니다. 계속하려면 <warn>⌥를 놓으세요</warn>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住<kbd>⌥</kbd>并移动以显示你隐藏的控件。<warn>松开 ⌥</warn>以继续。"
          }
        }
      }
