    "Start a drag in the <accent>highlighted region</accent> and move right to box-select several keyposes.": {
      "comment": "Advanced timing guide: start a marquee selection.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie einen Zug im <accent>markierten Bereich</accent> und ziehen Sie nach rechts, um mehrere Keyposes per Rahmen auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a arrastrar en la <accent>región resaltada</accent> y muévete a la derecha para seleccionar varias poses clave con un recuadro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez un glissement dans la <accent>zone en surbrillance</accent> et déplacez-vous vers la droite pour sélectionner plusieurs poses clés au cadre."
          }
