#!/bin/bash
#
# One-time migration for the co.overpolish.* -> com.keyframeless.* rename.
#
# Bundle IDs and the app group changed, and macOS keys sandbox containers,
# preferences and caches by those identifiers. The .app bundles themselves
# install by PATH and are simply overwritten, but everything below would
# otherwise be silently orphaned - including ~31GB of downloaded models.
#
# What moves (worth keeping):
#   ~/Library/Group Containers/group.co.overpolish.keyframeless
#     huggingface/  Kai local models (tens of GB)
#     Sonar/        published spectrograms, Links/, Thumbnails/, Manifests/
#   ~/Library/Containers/co.overpolish.keyframeless.Keyframeless-X.Keyframeless-X-FCP
#     Documents/huggingface     WhisperKit transcription models
#     Documents/whisper-models  GGML (Intel) transcription models
#     Library/Application Support/FluidAudio  Parakeet models
#
# What is deleted (dead): containers, prefs and caches for retired plugins
# (Glow, Magic Move, Rounded, Mesh, Shader, AudioChamber, Spectrum) and the
# superseded LaunchAgents.
#
# NOT touched: ~/Library/Application Support/Keyframeless/ - that is path-based,
# not identifier-based, so the AI helper's LocalModels/ and Models/ (~11GB) are
# unaffected by the rename and must stay exactly where they are.
#
# Container migration is BEST EFFORT. If macOS declines to adopt a moved
# container the only cost is a re-download, never data loss or a broken install,
# so every step here is non-fatal.

set -u

CURRENT_USER=$(stat -f "%Su" /dev/console)
USER_HOME=$(eval echo "~$CURRENT_USER")
MARKER="$USER_HOME/Library/Application Support/Keyframeless/.migrated-com-keyframeless"
LOG="$USER_HOME/Library/Logs/Keyframeless-migration.log"

mkdir -p "$(dirname "$LOG")" 2>/dev/null
exec >>"$LOG" 2>&1
echo "=== migration run $(date) (user: $CURRENT_USER) ==="

# Already migrated: this is a rename that happens once, and re-running after the
# user has started using the NEW locations could clobber newer data.
if [ -f "$MARKER" ]; then
  echo "marker present, nothing to do"
  exit 0
fi

as_user() { sudo -u "$CURRENT_USER" "$@"; }

MIGRATION_OK=1

# Merge an old directory into an already-created new directory without
# overwriting either side. Missing entries are moved into place. Identical
# files are de-duplicated. A genuinely different old file is kept beside the
# new one with a visible suffix so the migration can never silently discard it.
unique_old_path() {
  local target="$1"
  local candidate="${target}.from-overpolish"
  local number=2
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    candidate="${target}.from-overpolish-${number}"
    number=$((number + 1))
  done
  printf '%s\n' "$candidate"
}

merge_old_tree() {
  local source="$1"
  local destination="$2"
  local entry name target preserved

  as_user mkdir -p "$destination" || return 1

  while IFS= read -r -d '' entry; do
    name=$(basename "$entry")
    target="$destination/$name"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
      mv "$entry" "$target" || return 1
    elif [ -d "$entry" ] && [ ! -L "$entry" ] && \
         [ -d "$target" ] && [ ! -L "$target" ]; then
      merge_old_tree "$entry" "$target" || return 1
      rmdir "$entry" || return 1
    elif [ -f "$entry" ] && [ -f "$target" ] && cmp -s "$entry" "$target"; then
      rm -f "$entry" || return 1
    else
      preserved=$(unique_old_path "$target")
      mv "$entry" "$preserved" || return 1
      echo "  preserved conflict as ${preserved#$NEW_GROUP/}"
    fi
  done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
}

# --- 1. Superseded LaunchAgents ------------------------------------------
# The helper's plist is installed by FILENAME, so the renamed one lands beside
# the old rather than replacing it, leaving two agents with the old one still
# loaded and pointing at a replaced binary. AIService is an older generation
# still loaded on some machines.
UID_NUM=$(id -u "$CURRENT_USER")
for label in co.overpolish.keyframeless.aihelper co.overpolish.keyframeless.AIService; do
  as_user launchctl bootout "gui/$UID_NUM/$label" 2>/dev/null \
    && echo "unloaded $label"
  rm -f "/Library/LaunchAgents/$label.plist" \
        "$USER_HOME/Library/LaunchAgents/$label.plist" \
    && echo "removed agent plist $label"
done

# --- 2. App group container ------------------------------------------------
OLD_GROUP="$USER_HOME/Library/Group Containers/group.co.overpolish.keyframeless"
NEW_GROUP="$USER_HOME/Library/Group Containers/group.com.keyframeless"
if [ -d "$OLD_GROUP" ]; then
  echo "group: migrating $(du -sh "$OLD_GROUP" 2>/dev/null | cut -f1)"
  as_user mkdir -p "$NEW_GROUP" || MIGRATION_OK=0
  while IFS= read -r -d '' item; do
    name=$(basename "$item")
    # The socket is recreated by the helper; never carry a stale one over.
    if [ "$name" = "kkai.sock" ]; then
      rm -f "$item"
      continue
    fi
    if [ -e "$NEW_GROUP/$name" ] || [ -L "$NEW_GROUP/$name" ]; then
      if [ -d "$item" ] && [ ! -L "$item" ] && \
         [ -d "$NEW_GROUP/$name" ] && [ ! -L "$NEW_GROUP/$name" ]; then
        echo "  merge $name (already present)"
        if merge_old_tree "$item" "$NEW_GROUP/$name"; then
          rmdir "$item" || MIGRATION_OK=0
        else
          echo "  ERROR: could not completely merge $name; old data retained"
          MIGRATION_OK=0
        fi
      elif [ -f "$item" ] && [ -f "$NEW_GROUP/$name" ] && \
           cmp -s "$item" "$NEW_GROUP/$name"; then
        rm -f "$item" || MIGRATION_OK=0
      else
        preserved=$(unique_old_path "$NEW_GROUP/$name")
        if mv "$item" "$preserved"; then
          echo "  preserved conflict as ${preserved#$NEW_GROUP/}"
        else
          echo "  ERROR: could not preserve conflicting $name; old data retained"
          MIGRATION_OK=0
        fi
      fi
    else
      if mv "$item" "$NEW_GROUP/$name"; then
        echo "  moved $name"
      else
        echo "  ERROR: could not move $name; old data retained"
        MIGRATION_OK=0
      fi
    fi
  done < <(find "$OLD_GROUP" -mindepth 1 -maxdepth 1 -print0)
  # The metadata plist names the OLD group; leaving it would misidentify the
  # container. containermanagerd rewrites it on first entitled access.
  rm -f "$NEW_GROUP/.com.apple.containermanagerd.metadata.plist"
  chown -R "$CURRENT_USER:staff" "$NEW_GROUP" || MIGRATION_OK=0
  if ! rmdir "$OLD_GROUP" 2>/dev/null; then
    echo "group: old container retained because migration was incomplete"
    MIGRATION_OK=0
  fi
fi

# --- 3. Keyframeless X container (transcription models) --------------------
# Sandbox containers are keyed by bundle ID, so the extension gets a brand new
# one and its ~9GB of models would need re-downloading. Move the model trees
# only - not the whole container - so no stale sandbox metadata is inherited.
OLD_X="$USER_HOME/Library/Containers/co.overpolish.keyframeless.Keyframeless-X.Keyframeless-X-FCP/Data"
NEW_X="$USER_HOME/Library/Containers/com.keyframeless.Keyframeless-X.Keyframeless-X-FCP/Data"
if [ -d "$OLD_X" ]; then
  echo "steno: migrating models"
  for rel in "Documents/huggingface" "Documents/whisper-models" \
             "Library/Application Support/FluidAudio" \
             "Library/Application Support/Keyframeless"; do
    src="$OLD_X/$rel"
    dst="$NEW_X/$rel"
    [ -d "$src" ] || continue
    if [ -e "$dst" ]; then
      echo "  skip $rel (already present)"
      continue
    fi
    as_user mkdir -p "$(dirname "$dst")" 2>/dev/null
    mv "$src" "$dst" && echo "  moved $rel ($(du -sh "$dst" 2>/dev/null | cut -f1))"
  done
  chown -R "$CURRENT_USER:staff" "$NEW_X" 2>/dev/null
  # Leave the old container in place: it also holds temp audio and caches the
  # janitor knows how to clear, and deleting a live container is not our call.
fi

# --- 4. Preferences --------------------------------------------------------
# Small user settings (intro seen, popover size). Copy rather than move so a
# rollback still finds the originals; cfprefsd picks the new domain up on the
# next launch.
PREFS="$USER_HOME/Library/Preferences"
for old in "$PREFS"/co.overpolish.keyframeless.*.plist; do
  [ -e "$old" ] || continue
  base=$(basename "$old")
  case "$base" in
    *Canvas*|*Mirage*|*Keyframeless-X*)
      new="$PREFS/${base/co.overpolish.keyframeless./com.keyframeless.}"
      [ -e "$new" ] || { cp "$old" "$new" && chown "$CURRENT_USER:staff" "$new" \
        && echo "prefs: copied $base"; }
      ;;
  esac
done

# --- 5. Retired plugins ----------------------------------------------------
# Glow, Magic Move and Rounded are Mirage templates now; Mesh and Shader are
# what Mirage was called before; AudioChamber and Spectrum never shipped.
for dead in Glow MagicMove Rounded Mesh Shader AudioChamber Spectrum; do
  rm -rf "$USER_HOME/Library/Containers/co.overpolish.keyframeless.$dead" \
         "$USER_HOME/Library/Containers/co.overpolish.keyframeless.$dead.PlugIn" \
         "$USER_HOME/Library/Caches/co.overpolish.keyframeless.$dead.PlugIn" \
         "$PREFS/co.overpolish.keyframeless.$dead.PlugIn.plist"
done
# Remaining old-identifier containers and caches for products that DID survive:
# their data has been migrated above, so the husks can go.
rm -rf "$USER_HOME/Library/Containers/co.overpolish.keyframeless.Canvas.PlugIn" \
       "$USER_HOME/Library/Containers/co.overpolish.keyframeless.Mirage.PlugIn" \
       "$USER_HOME/Library/Caches/co.overpolish.keyframeless.Canvas.PlugIn" \
       "$USER_HOME/Library/Caches/co.overpolish.keyframeless.Mirage.PlugIn" \
       "$USER_HOME/Library/Caches/co.overpolish.keyframeless.KeyframelessAIService"
echo "removed retired containers/caches"

# --- 6. Done ---------------------------------------------------------------
if [ "$MIGRATION_OK" -eq 1 ]; then
  if as_user mkdir -p "$(dirname "$MARKER")" 2>/dev/null && \
     as_user touch "$MARKER"; then
    echo "=== migration complete ==="
    exit 0
  fi
  echo "ERROR: could not write migration marker"
fi

echo "=== migration incomplete; it will retry on the next install ==="
exit 1
