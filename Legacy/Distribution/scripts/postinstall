#!/bin/bash

CURRENT_USER=$(stat -f "%Su" /dev/console)
USER_HOME=$(eval echo ~$CURRENT_USER)
MOTION_TEMPLATES_BASE="$USER_HOME/Movies/Motion Templates.localized"
FOUND_TEMPLATES=0

# Works with any plugin by copying across correct motion template tree
for TEMPLATE_TYPE_DIR in Effects.localized Generators.localized Titles.localized Transitions.localized; do
    if [ -d "./$TEMPLATE_TYPE_DIR" ]; then
        DEST_DIR="$MOTION_TEMPLATES_BASE/$TEMPLATE_TYPE_DIR"
        mkdir -p "$DEST_DIR"
        chown "$CURRENT_USER:staff" "$MOTION_TEMPLATES_BASE"
        chown "$CURRENT_USER:staff" "$DEST_DIR"
        cp -R "./$TEMPLATE_TYPE_DIR/"* "$DEST_DIR/"
        chown -R "$CURRENT_USER:staff" "$DEST_DIR"
        FOUND_TEMPLATES=1
    fi
done

# Install the uninstall script alongside the app, named for the product. Per-product
# builds carry a `PLUGIN="..."` line; the suite bundle's uninstall has none, so it
# falls back to "Keyframeless".
SCRIPT_DIR="$(dirname "$0")"
# The legacy-plugin uninstaller is copied separately below, so keep it out of the
# primary "Uninstall <product>" selection (per-product builds rename the main one
# to uninstall-<component>, which would otherwise sort after uninstall-legacy-*).
UNINSTALL=$(ls "$SCRIPT_DIR"/uninstall* 2>/dev/null | grep -v 'uninstall-legacy-plugins' | head -1)
if [ -n "$UNINSTALL" ] && [ -d "$2" ]; then
    PLUGIN_NAME=$(sed -n 's/^PLUGIN="\(.*\)"$/\1/p' "$UNINSTALL" | head -1)
    [ -z "$PLUGIN_NAME" ] && PLUGIN_NAME="Keyframeless"
    cp "$UNINSTALL" "$2/Uninstall $PLUGIN_NAME"
    chmod +x "$2/Uninstall $PLUGIN_NAME"
fi

# The retired Rounded / Magic Move / Glow standalone plugins ship a dedicated
# uninstaller (bundled with Mirage). Drop it beside the app when present, so an
# install/update offers to clean up the old standalone plugins.
LEGACY="$SCRIPT_DIR/uninstall-legacy-plugins"
if [ -f "$LEGACY" ] && [ -d "$2" ]; then
    cp "$LEGACY" "$2/Uninstall Legacy Plugins"
    chmod +x "$2/Uninstall Legacy Plugins"
fi

# One-time migration for the co.overpolish.* -> com.keyframeless.* rename:
# moves the app group + transcription models onto the new identifiers and
# clears the superseded LaunchAgents and retired plugins. Self-guarding (marker
# file), non-fatal, and a no-op once it has run.
MIGRATE="$SCRIPT_DIR/migrate-identifiers"
if [ -f "$MIGRATE" ]; then
    bash "$MIGRATE" || true
fi

# ONE-RELEASE LICENSE MIGRATION (installation identity v1).
#
# Releases before this migration bound signed records to gethostuuid. FxPlug
# services and app extensions can observe a different privacy-scoped value in
# different execution contexts, leaving the inspector activated while the
# renderer rejects the same record. The new clients use one UUID file in the
# shared app-group container instead, so every legacy record must be removed
# once and re-issued against that installation ID.
#
# Remove this block after the first release containing the installation-ID
# clients has shipped. The marker also keeps separate product installers from
# repeatedly signing the user out during that transition release.
if [ -n "$CURRENT_USER" ] && [ "$CURRENT_USER" != "root" ]; then
    LICENSE_RESET_MARKER="$USER_HOME/Library/Application Support/Keyframeless/.licenses-reset-installation-id-v1"
    if [ ! -f "$LICENSE_RESET_MARKER" ]; then
        as_user() { sudo -u "$CURRENT_USER" "$@"; }
        NEW_GROUP_PREFS="$USER_HOME/Library/Group Containers/group.com.keyframeless/Library/Preferences/group.com.keyframeless"
        OLD_GROUP_PREFS="$USER_HOME/Library/Group Containers/group.co.overpolish.keyframeless/Library/Preferences/group.co.overpolish.keyframeless"
        for key in \
            com.keyframeless.license.mirage \
            com.keyframeless.license.canvas \
            com.keyframeless.license.steno; do
            as_user /usr/bin/defaults delete group.com.keyframeless "$key" 2>/dev/null || true
            as_user /usr/bin/defaults delete group.co.overpolish.keyframeless "$key" 2>/dev/null || true
            as_user /usr/bin/defaults delete "$NEW_GROUP_PREFS" "$key" 2>/dev/null || true
            as_user /usr/bin/defaults delete "$OLD_GROUP_PREFS" "$key" 2>/dev/null || true
        done
        as_user mkdir -p "$(dirname "$LICENSE_RESET_MARKER")" &&
            as_user touch "$LICENSE_RESET_MARKER"
    fi
fi

exit 0
