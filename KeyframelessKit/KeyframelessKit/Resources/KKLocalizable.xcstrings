    },
    "Tap <accent>Advanced</accent> for the per-property timeline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf <accent>Erweitert</accent> für die Timeline pro Eigenschaft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez <accent>Avancé</accent> pour la timeline par propriété."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca <accent>Avanzado</accent> para la línea de tiempo por propiedad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>詳細</accent>をタップすると、プロパティごとのタイムラインが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속성별 타임라인을 보려면 <accent>고급</accent>을 탭하세요."
