{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" isn't an SF Symbol on this Mac - check the name in the SF Symbols app": {
      "comment": "Mirage unknown group-icon validation error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist auf diesem Mac kein SF Symbol – prüfe den Namen in der App „SF Symbols“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un SF Symbol en este Mac: comprueba el nombre en la app SF Symbols"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'est pas un SF Symbol sur ce Mac : vérifiez le nom dans l'app SF Symbols"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこの Mac の SF Symbol ではありません。SF Symbols アプリで名前を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"은(는) 이 Mac의 SF Symbol이 아닙니다. SF Symbols 앱에서 이름을 확인하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是此 Mac 上的 SF Symbol，请在 SF Symbols App 中核对名称"
          }
        }
      }
    },
    "-1, 0 or 1 for the sign.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "-1, 0 oder 1 für das Vorzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "-1, 0 o 1 según el signo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "-1, 0 ou 1 selon le signe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "符号に応じて -1、0、1。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부호에 따라 -1, 0 또는 1입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号为 -1、0 或 1。"
          }
        }
      }
    },
    "0 below the edge, 1 at or above it.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 unterhalb der Kante, 1 an oder oberhalb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 por debajo del borde, 1 en el borde o por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 sous le bord, 1 au bord ou au-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジより下で 0、エッジ以上で 1。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경계 아래에서는 0, 경계 이상에서는 1입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于边界为 0，达到或高于边界为 1。"
          }
        }
      }
    },
    "1 over square root, fast.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 durch Quadratwurzel, schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dividido por la raíz cuadrada, rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 sur racine carrée, rapide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1÷平方根（高速）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1 나누기 제곱근으로, 빠릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 除以平方根，快速。"
          }
        }
