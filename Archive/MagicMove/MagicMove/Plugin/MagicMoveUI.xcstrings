    "Drag a <warn>corner</warn> out to about <accent>200%</accent>.": {
      "comment": "Shaping guide: scale the keypose up to 200%.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine <warn>Ecke</warn> auf etwa <accent>200%</accent> heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una <warn>esquina</warn> hacia afuera hasta aproximadamente <accent>200%</accent>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un <warn>coin</warn> vers l'extérieur jusqu'à environ <accent>200%</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>角</warn>を外側へ、約<accent>200%</accent>までドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>모서리</warn>를 바깥으로 약 <accent>200%</accent>까지 드래그하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个<warn>角</warn>向外拖动到约<accent>200%</accent>。"
          }
        }
      }
    },
    "Drag each control right on the preview, or type exact numbers in the inspector. Put Crop or similar effects below Magic Move so they travel with the moved clip.": {
      "comment": "Magic Move help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh jede Steuerung direkt in der Vorschau, oder gib genaue Zahlen im Inspektor ein. Platziere Crop oder ähnliche Effekte unter Magic Move, damit sie mit dem bewegten Clip mitreisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra cada control directamente en la previsualización, o escribe números exactos en el inspector. Coloca Crop o efectos similares debajo de Magic Move para que viajen con el clip movido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser chaque commande directement sur l'aperçu, ou saisissez des valeurs précises dans l'inspecteur. Placez Crop ou des effets similaires sous Magic Move pour qu'ils suivent le clip déplacé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各コントロールはプレビュー上で直接ドラッグするか、インスペクタに正確な数値を入力します。Crop などの効果を Magic Move の下に置くと、動かしたクリップに付いて移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 컨트롤을 미리보기에서 바로 드래그하거나 인스펙터에 정확한 숫자를 입력하세요. Crop이나 비슷한 효과를 Magic Move 아래에 두면 움직인 클립을 따라 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在预览上拖动每个控件，或在检查器中输入精确数值。把 Crop 或类似效果放在 Magic Move 下方，它们就会随移动的片段一起移动。"
          }
        }
      }
    },
    "Fine adjustment": {
      "comment": "Magic Move help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feinabstimmung"
          }
        },
        "es": {
          "stringUnit": {
