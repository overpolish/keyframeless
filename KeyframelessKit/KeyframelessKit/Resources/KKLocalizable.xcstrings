      "comment": "Advanced timing guide: open the Advanced editor."
    },
    "Tap <accent>Dynamic</accent> to space out short transitions so they stay easy to grab on a long clip.": {
      "comment": "Advanced timing guide: try the Dynamic display toggle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf <accent>Dynamisch</accent>, um kurze Übergänge zu spreizen, damit sie auf einem langen Clip leicht zu greifen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca <accent>Dinámico</accent> para separar las transiciones cortas y que sigan siendo fáciles de agarrar en un clip largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez <accent>Dynamique</accent> pour espacer les transitions courtes afin qu'elles restent faciles à saisir sur un plan long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>ダイナミック</accent>をタップすると、短いトランジションが広がり、長いクリップでもつかみやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>다이내믹</accent>을 탭하면 짧은 트랜지션이 넓어져 긴 클립에서도 쉽게 잡을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击<accent>动态</accent>可拉开短转场，使其在长片段上也易于抓取。"
          }
        }
      }
    },
    "Tap <accent>Filmstrip</accent> to lay out every keypose.": {
      "extractionState": "manual",
      "comment": "Mini-viewer guide: switch to filmstrip mode.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf <accent>Filmstreifen</accent>, um alle Keyposes anzuordnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez <accent>Pellicule</accent> pour disposer toutes les poses clés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca <accent>Tira de fotogramas</accent> para distribuir todas las poses clave."
