    "Declares an input value, usually from a // # directive.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklariert einen Eingabewert, meist aus einer // #-Direktive."
          }
        },
