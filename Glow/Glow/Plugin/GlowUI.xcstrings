    "Glow": {
      "comment": "Help section title (plugin name).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glow"
          }
        },
        "ja": {
          "stringUnit": {
