      }
    },
    "Curve the path and scale a keypose": {
      "comment": "Help guide subtitle: Shaping a Move.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Pfad kurven und eine Keypose skalieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva la trayectoria y escala una pose clave"
