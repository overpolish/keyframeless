        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에나 키포즈를 추가하고 속성별로 트랜지션을 조정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置添加关键姿势，并按属性调整过渡"
          }
        }
      },
      "comment": "Help guide subtitle: Advanced Timing."
    },
