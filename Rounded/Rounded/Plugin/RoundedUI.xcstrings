{
  "sourceLanguage": "en",
  "strings": {
    "<accent>Box</accent> crops and positions the clip — animate it to reveal or hide content over time.": {
      "comment": "Help tip: what the Box/Crop property does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Box</accent> beschneidet und positioniert den Clip — animiere sie, um Inhalte mit der Zeit ein- oder auszublenden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>方框</accent>用于裁剪和定位片段——为其制作动画即可随时间显示或隐藏内容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <accent>boîte</accent> recadre et positionne le plan — animez-la pour révéler ou masquer du contenu au fil du temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>ボックス</accent>はクリップを切り抜いて配置します。アニメーションで時間の経過とともにコンテンツを表示または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>박스</accent>는 클립을 자르고 위치를 지정합니다. 애니메이션으로 시간에 따라 콘텐츠를 표시하거나 숨길 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El <accent>cuadro</accent> recorta y posiciona el clip: anímalo para mostrar u ocultar contenido a lo largo del tiempo."
          }
        }
      }
    },
    "<accent>Cmd-click</accent> the Crop lane at the <warn>glowing target</warn> to add a keypose": {
      "comment": "Advanced timing guide: add a keypose to the Crop lane.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Cmd-Klick</accent> auf die Zuschnitt-Spur beim <warn>leuchtenden Ziel</warn>, um eine Keypose hinzuzufügen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在<warn>发光目标</warn>处<accent>按住 Cmd 键点按</accent>裁剪轨道以添加关键姿势"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Cmd-cliquez</accent> sur la piste Recadrage au niveau de la <warn>cible lumineuse</warn> pour ajouter une pose clé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>光るターゲット</warn>の位置でクロップレーンを<accent>Cmd キーを押しながらクリック</accent>してキーポーズを追加します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>빛나는 대상</warn> 위치에서 자르기 레인을 <accent>Cmd-클릭</accent>하여 키포즈를 추가하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Cmd-clic</accent> en la pista de Recorte sobre la <warn>diana luminosa</warn> para añadir una pose clave"
          }
        }
      }
    },
    "<accent>Double-click</accent> the preview to reset the view": {
      "comment": "Constants guide: reset the mini-canvas zoom/pan.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Doppelklick</accent> auf die Vorschau, um die Ansicht zurückzusetzen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>双击</accent>预览以重置视图"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Double-cliquez</accent> sur l'aperçu pour réinitialiser la vue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを<accent>ダブルクリック</accent>すると表示がリセットされます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기를 <accent>더블 클릭</accent>하여 보기를 재설정하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz <accent>doble clic</accent> en la previsualización para restablecer la vista"
          }
        }
      }
    },
    "Add animatable properties and turn on a transition": {
      "comment": "Help guide subtitle: Timing Basics.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animierbare Eigenschaften hinzufügen und einen Übergang aktivieren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加可制作动画的属性并开启过渡"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des propriétés animables et activez une transition"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーション可能なプロパティを追加してトランジションをオンにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션 가능한 속성을 추가하고 전환을 켜세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade propiedades animables y activa una transición"
          }
        }
      }
    },
    "Add keyposes anywhere and shape transitions per property": {
      "comment": "Help guide subtitle: Advanced Timing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyposes überall hinzufügen und Übergänge pro Eigenschaft gestalten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置添加关键姿势，并为每个属性塑造过渡"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des poses clés où vous voulez et façonnez les transitions par propriété"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の場所にキーポーズを追加し、プロパティごとにトランジションを調整します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에나 키포즈를 추가하고 속성별로 전환을 조정하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade poses clave donde quieras y da forma a las transiciones por propiedad"
          }
        }
      }
    },
    "Advanced Timing": {
      "comment": "Help guide title: advanced timing walkthrough.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitertes Timing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级计时"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutage avancé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細なタイミング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 타이밍"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización avanzada"
          }
        }
      }
    },
    "Basic timing has three phases: <accent>In</accent>, <accent>Hold</accent>, and <accent>Out</accent>": {
      "comment": "Basic timing guide: explains the three phases.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfaches Timing hat drei Phasen: <accent>Ein</accent>, <accent>Halten</accent> und <accent>Aus</accent>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本计时有三个阶段：<accent>进入</accent>、<accent>保持</accent>和<accent>退出</accent>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minutage de base comporte trois phases : <accent>Entrée</accent>, <accent>Maintien</accent> et <accent>Sortie</accent>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本のタイミングには 3 つのフェーズがあります：<accent>イン</accent>、<accent>ホールド</accent>、<accent>アウト</accent>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 타이밍에는 세 단계가 있습니다: <accent>인</accent>, <accent>홀드</accent>, <accent>아웃</accent>"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización básica tiene tres fases: <accent>Entrada</accent>, <accent>Mantener</accent> y <accent>Salida</accent>"
          }
        }
      }
    },
    "Click <symbol play.fill color=accent /> to play, then again to <accent>pause</accent> — handy when <warn>spacebar</warn> isn't working": {
      "comment": "Basic timing guide: play/pause from the inspector.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf <symbol play.fill color=accent />, um abzuspielen, dann erneut zum <accent>Pausieren</accent> — praktisch, wenn die <warn>Leertaste</warn> nicht funktioniert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 <symbol play.fill color=accent /> 播放，再次点按可<accent>暂停</accent>——当<warn>空格键</warn>失效时很实用"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur <symbol play.fill color=accent /> pour lire, puis à nouveau pour mettre en <accent>pause</accent> — pratique quand la <warn>barre d'espace</warn> ne fonctionne pas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<symbol play.fill color=accent /> をクリックして再生し、もう一度クリックすると<accent>一時停止</accent>します。<warn>スペースバー</warn>が効かないときに便利です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<symbol play.fill color=accent /> 을 클릭하여 재생하고 다시 클릭하면 <accent>일시정지</accent>됩니다. <warn>스페이스바</warn>가 작동하지 않을 때 유용합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en <symbol play.fill color=accent /> para reproducir y de nuevo para <accent>pausar</accent>: útil cuando la <warn>barra espaciadora</warn> no funciona"
          }
        }
      }
    },
    "Click one of the <accent>diamonds</accent> to edit values at that point in time": {
      "comment": "Basic timing guide: edit a keypose diamond.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf eine der <accent>Rauten</accent>, um Werte zu diesem Zeitpunkt zu bearbeiten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按其中一个<accent>菱形</accent>以编辑该时间点的值"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un des <accent>losanges</accent> pour modifier les valeurs à ce moment précis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>ひし形</accent>のいずれかをクリックすると、その時点の値を編集できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>다이아몬드</accent> 중 하나를 클릭하여 해당 시점의 값을 편집하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en uno de los <accent>rombos</accent> para editar los valores en ese punto del tiempo"
          }
        }
      }
    },
    "Click the <accent>circle</accent> in the viewer to control the radius": {
      "comment": "OSC guide: click message for the radius circle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den <accent>Kreis</accent> im Viewer, um den Radius zu steuern"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按检视器中的<accent>圆圈</accent>以控制半径"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le <accent>cercle</accent> dans le visualiseur pour contrôler le rayon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューアの<accent>円</accent>をクリックすると半径を調整できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰어의 <accent>원</accent>을 클릭하여 반지름을 조절하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el <accent>círculo</accent> del visor para controlar el radio"
          }
        }
      }
    },
    "Click the <accent>dot</accent> to set the corner radius": {
      "comment": "Constants guide: click message for the radius dot.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den <accent>Punkt</accent>, um den Eckenradius festzulegen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按<accent>圆点</accent>以设置圆角半径"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le <accent>point</accent> pour définir le rayon des coins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>ドット</accent>をクリックして角の半径を設定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>점</accent>을 클릭하여 모서리 반지름을 설정하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el <accent>punto</accent> para ajustar el radio de las esquinas"
          }
        }
      }
    },
    "Click the <accent>gap</accent> between keyposes to edit timing": {
      "comment": "Advanced timing guide: click a gap segment.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den <accent>Zwischenraum</accent> zwischen Keyposes, um das Timing zu bearbeiten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按关键姿势之间的<accent>间隙</accent>以编辑计时"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l'<accent>espace</accent> entre les poses clés pour modifier le minutage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーポーズ間の<accent>すき間</accent>をクリックするとタイミングを編集できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키포즈 사이의 <accent>간격</accent>을 클릭하여 타이밍을 편집하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el <accent>espacio</accent> entre poses clave para editar la sincronización"
          }
        }
      }
    },
    "Click the <accent>top-left</accent> crop corner": {
      "comment": "Constants guide: click message for the crop corner.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die <accent>obere linke</accent> Beschnittecke"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按<accent>左上角</accent>裁剪角"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le coin de recadrage <accent>en haut à gauche</accent>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>左上</accent>のクロップ角をクリックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>왼쪽 위</accent> 자르기 모서리를 클릭하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la esquina de recorte <accent>superior izquierda</accent>"
          }
        }
      }
    },
    "Click the <accent>X</accent> field and type <warn>100</warn>": {
      "comment": "Constants guide: type a value into the X field.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das <accent>X</accent>-Feld und gib <warn>100</warn> ein"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 <accent>X</accent> 字段并输入 <warn>100</warn>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le champ <accent>X</accent> et saisissez <warn>100</warn>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>X</accent> フィールドをクリックして <warn>100</warn> と入力します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>X</accent> 필드를 클릭하고 <warn>100</warn>을 입력하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el campo <accent>X</accent> y escribe <warn>100</warn>"
          }
        }
      }
    },
    "Constants": {
      "comment": "Help guide title: editing non-animating values.",
      "extractionState": "manual",
      "localizations": {
        "de": {
