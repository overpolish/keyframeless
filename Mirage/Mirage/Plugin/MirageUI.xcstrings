          }
        }
      }
    },
    "Slot group \"%@\": min= and default= must be 0 to max=, and default can't be below min=": {
      "comment": "Mirage slots count error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot-Gruppe „%@“: min= und default= müssen zwischen 0 und max= liegen, und default darf nicht unter min= liegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupo de slots «%@»: min= y default= deben ir de 0 a max=, y default no puede ser menor que min="
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupe de slots « %@ » : min= et default= doivent aller de 0 à max=, et default ne peut pas être inférieur à min="
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロットグループ「%@」: min= と default= は 0〜max= の範囲で、default は min= を下回れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬롯 그룹 \"%@\": min=과 default=는 0에서 max= 사이여야 하며 default는 min=보다 작을 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插槽组“%@”：min= 与 default= 必须在 0 到 max= 之间，且 default 不能小于 min="
          }
        }
      }
    },
    "Control \"%@\": #gradient, #audio and colour arrays can't repeat - declare them outside the #slots block": {
      "comment": "Mirage unrepeatable slots control error.",
      "extractionState": "manual",
      "localizations": {
