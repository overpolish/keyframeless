            "state": "translated",
            "value": "Scintillement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シマー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반짝임"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微光闪烁"
          }
        }
      }
    },
    "Pulsing Glow": {
      "comment": "Built-in preset name: the glow radius pulses in and out.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsierendes Leuchten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resplandor pulsante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lueur pulsée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脈動するグロー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥동하는 글로우"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脉动辉光"
          }
        }
      }
    },
    "Glow In": {
      "comment": "Built-in preset name: the glow grows in from nothing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchten ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resplandor entrante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lueur entrante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글로우 인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辉光渐入"
          }
        }
      }
    },
    "<accent>Advanced</accent> - the full keyposes + intervals model: any number of keyposes, each interval with its own curve and modulation. Use it for multi-step motion or custom holds.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Erweitert</accent> - das vollständige Keyposes-und-Intervalle-Modell: beliebig viele Keyposes, jedes Intervall mit eigener Kurve und Modulation. Verwende es für mehrstufige Bewegung oder eigene Haltephasen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Avanzado</accent> - el modelo completo de keyposes e intervalos: cualquier número de keyposes, cada intervalo con su propia curva y modulación. Úsalo para movimiento de varios pasos o mantenimientos personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Avancé</accent> - le modèle complet keyposes + intervalles : autant de keyposes que voulu, chaque intervalle avec sa propre courbe et modulation. À utiliser pour un mouvement en plusieurs étapes ou des maintiens personnalisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>詳細</accent> - キーポーズと区間の完全なモデル。キーポーズはいくつでも、各区間が独自のカーブとモジュレーションを持ちます。多段階の動きやカスタムな保持に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>고급</accent> - 키포즈와 구간의 완전한 모델: 키포즈는 원하는 만큼, 각 구간이 고유한 커브와 모듈레이션을 가집니다. 다단계 움직임이나 사용자 지정 유지에 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>高级</accent> - 完整的关键姿势与区间模型：任意数量的关键姿势，每个区间都有自己的曲线和调制。用于多步运动或自定义保持。"
          }
        }
      }
    },
    "<accent>Always</accent>: blur every frame regardless of motion.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Immer</accent>: Unschärfe in jedem Bild, unabhängig von Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Siempre</accent>: desenfoque en cada fotograma sin importar el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Toujours</accent> : flou sur chaque image, quel que soit le mouvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>常に</accent>: 動きに関係なく毎フレームブラーをかけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>항상</accent>: 움직임과 관계없이 매 프레임에 블러를 적용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>始终</accent>：无论是否运动，每一帧都模糊。"
          }
        }
      }
    },
    "<accent>Apply at playhead</accent> - the insert button drops the preset's move in at the playhead and keeps your existing keyposes, so you can stack a Pop In early and a Pop Out later on the same clip.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>An Abspielposition anwenden</accent> - die Einfügen-Taste setzt die Bewegung des Presets an der Abspielposition ein und behält Ihre vorhandenen Keyposes, sodass Sie z. B. früh ein Pop In und später ein Pop Out im selben Clip kombinieren können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Aplicar en la posición de reproducción</accent> - el botón de insertar coloca el movimiento del preajuste en la posición de reproducción y conserva tus poses clave existentes, así puedes combinar una Aparición pop al principio y una Desaparición pop más tarde en el mismo clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Appliquer à la tête de lecture</accent> - le bouton d'insertion place le mouvement du préréglage à la tête de lecture et conserve vos poses clés existantes, ce qui permet de combiner une Apparition pop au début et une Disparition pop plus tard sur le même plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>再生ヘッドに適用</accent> - 挿入ボタンはプリセットの動きを再生ヘッドの位置に挿入し、既存のキーポーズはそのまま残します。同じクリップで前半にポップイン、後半にポップアウトを重ねられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>재생 헤드에 적용</accent> - 삽입 버튼은 프리셋의 움직임을 재생 헤드 위치에 넣고 기존 키포즈를 유지합니다. 그래서 같은 클립에서 앞쪽에 팝 인, 뒤쪽에 팝 아웃을 쌓을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>在播放头处应用</accent> - 插入按钮会在播放头处放入预设的动作并保留你已有的关键姿势，因此你可以在同一片段上先弹入、稍后再弹出。"
          }
        }
      }
    },
    "<accent>Apply</accent> - click a preset to replace the current animation with it.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Anwenden</accent> - klicken Sie auf ein Preset, um die aktuelle Animation damit zu ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Aplicar</accent> - haz clic en un preajuste para reemplazar la animación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Appliquer</accent> - cliquez sur un préréglage pour remplacer l'animation actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>適用</accent> - プリセットをクリックすると、現在のアニメーションが置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>적용</accent> - 프리셋을 클릭하면 현재 애니메이션이 대체됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>应用</accent> - 点击预设即可替换当前动画。"
          }
        }
      }
    },
    "<accent>Basic</accent> - three checkboxed phases (<accent>In</accent>, <accent>Hold</accent>, <accent>Out</accent>) for a simple ease-in, hold, ease-out. Drag the hold boundary to move where In ends and Out begins.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Einfach</accent> - drei ankreuzbare Phasen (<accent>Ein</accent>, <accent>Halten</accent>, <accent>Aus</accent>) für ein einfaches Einblenden, Halten, Ausblenden. Ziehe die Haltegrenze, um zu verschieben, wo Ein endet und Aus beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Básico</accent> - tres fases con casilla (<accent>Entrada</accent>, <accent>Mantener</accent>, <accent>Salida</accent>) para una entrada, mantenimiento y salida simples. Arrastra el límite del mantenimiento para mover dónde termina la Entrada y empieza la Salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Basique</accent> - trois phases à cocher (<accent>Entrée</accent>, <accent>Maintien</accent>, <accent>Sortie</accent>) pour une entrée, un maintien et une sortie simples. Glissez la limite du maintien pour déplacer où l'Entrée finit et la Sortie commence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>基本</accent> - チェックボックス付きの3フェーズ(<accent>イン</accent>、<accent>ホールド</accent>、<accent>アウト</accent>)でシンプルなイーズイン・ホールド・イーズアウト。ホールド境界をドラッグすると、インの終わりとアウトの始まりを移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>기본</accent> - 체크박스가 있는 세 단계(<accent>인</accent>, <accent>유지</accent>, <accent>아웃</accent>)로 간단한 이즈 인, 유지, 이즈 아웃. 유지 경계를 드래그하면 인이 끝나고 아웃이 시작되는 위치를 옮깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>基本</accent> - 三个带复选框的阶段(<accent>进入</accent>、<accent>保持</accent>、<accent>退出</accent>)，用于简单的缓入、保持、缓出。拖动保持边界可移动进入结束和退出开始的位置。"
          }
        }
      }
    },
    "<accent>Bounce</accent> - settles with a few decreasing bounces.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Abprall</accent> - pendelt sich mit einigen abnehmenden Sprüngen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Rebote</accent> - se estabiliza con unos rebotes decrecientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Rebond</accent> - se stabilise avec quelques rebonds décroissants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>バウンス</accent> - 徐々に小さくなるバウンドで落ち着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>바운스</accent> - 점점 작아지는 바운스로 안정됨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>弹跳</accent> - 以几次逐渐减小的弹跳稳定。"
          }
        }
      }
    },
    "<accent>Default presets</accent> - built-in starters like Pop In and Pop Out, marked with a Default badge. They are read-only.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Standard-Presets</accent> - integrierte Vorlagen wie Pop In und Pop Out, mit einem Standard-Badge gekennzeichnet. Sie sind schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Preajustes predeterminados</accent> - puntos de partida integrados como Aparición pop y Desaparición pop, marcados con la insignia Predeterminado. Son de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Préréglages par défaut</accent> - des points de départ intégrés comme Apparition pop et Disparition pop, marqués d'un badge Par défaut. Ils sont en lecture seule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>デフォルトプリセット</accent> - ポップインやポップアウトなどの組み込みのひな型で、デフォルトのバッジが付いています。読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>기본 프리셋</accent> - 팝 인, 팝 아웃 같은 기본 제공 시작점으로, 기본 배지가 표시됩니다. 읽기 전용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>默认预设</accent> - 内置的起始动画，例如弹入和弹出，带有“默认”徽章。它们为只读。"
          }
        }
      }
    },
    "<accent>Ease In/Out</accent> - slow at both ends (the default).": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Ease In/Out</accent> - an beiden Enden langsam (Standard)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Entrada y salida suaves</accent> - lento en ambos extremos (predeterminado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Accél./Décél.</accent> - lent aux deux extrémités (par défaut)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>イーズイン/アウト</accent> - 両端が遅い(デフォルト)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>이즈 인/아웃</accent> - 양 끝이 느림(기본값)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>缓入缓出</accent> - 两端慢(默认)。"
          }
        }
      }
    },
    "<accent>Ease In</accent> - slow start, accelerates.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Ease In</accent> - langsamer Start, beschleunigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Entrada suave</accent> - inicio lento, acelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Accélération</accent> - départ lent, accélère."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>イーズイン</accent> - ゆっくり始まり加速。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>이즈 인</accent> - 느리게 시작해 가속."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>缓入</accent> - 缓慢开始，逐渐加速。"
          }
        }
      }
    },
    "<accent>Ease Out</accent> - fast start, decelerates.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Ease Out</accent> - schneller Start, verlangsamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Salida suave</accent> - inicio rápido, desacelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Décélération</accent> - départ rapide, décélère."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>イーズアウト</accent> - 速く始まり減速。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>이즈 아웃</accent> - 빠르게 시작해 감속."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>缓出</accent> - 快速开始，逐渐减速。"
          }
        }
      }
    },
    "<accent>Elastic</accent> - overshoots and oscillates before settling.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Elastisch</accent> - schießt über und schwingt, bevor es sich einpendelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Elástico</accent> - se pasa y oscila antes de estabilizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Élastique</accent> - dépasse et oscille avant de se stabiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>エラスティック</accent> - 行き過ぎて振動してから落ち着く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>탄성</accent> - 지나쳤다가 진동한 뒤 안정됨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>弹性</accent> - 先过冲并振荡，然后稳定。"
          }
        }
      }
    },
    "<accent>Filter</accent> - type in the same field to narrow the list.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Filtern</accent> - tippen Sie in dasselbe Feld, um die Liste einzugrenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Filtrar</accent> - escribe en el mismo campo para acotar la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Filtrer</accent> - saisissez du texte dans le même champ pour réduire la liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>絞り込み</accent> - 同じフィールドに入力するとリストを絞り込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>필터</accent> - 같은 필드에 입력하면 목록을 좁힐 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>筛选</accent> - 在同一字段中输入即可缩小列表范围。"
          }
        }
      }
    },
    "<accent>Fixed transitions</accent> - a preset saves its transitions (the moving parts) as fixed durations and its holds as flexible, so an applied preset feels the same whether the clip is short or long.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Feste Übergänge</accent> - ein Preset sichert seine Übergänge (die bewegten Teile) mit fester Dauer und seine Haltephasen flexibel, sodass sich ein angewendetes Preset bei kurzen wie langen Clips gleich anfühlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Transiciones fijas</accent> - un preajuste guarda sus transiciones (las partes en movimiento) con una duración fija y sus mantenimientos de forma flexible, de modo que un preajuste aplicado se siente igual tanto en un clip corto como en uno largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Transitions fixes</accent> - un préréglage enregistre ses transitions (les parties en mouvement) avec une durée fixe et ses maintiens de façon flexible, afin qu'un préréglage appliqué donne le même ressenti que le plan soit court ou long."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>固定トランジション</accent> - プリセットはトランジション（動く部分）を固定の長さで、ホールドを可変で保存するため、適用したプリセットはクリップが短くても長くても同じ印象になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>고정 트랜지션</accent> - 프리셋은 트랜지션(움직이는 부분)을 고정된 길이로, 홀드를 유연하게 저장하므로 적용한 프리셋은 클립이 짧든 길든 동일하게 느껴집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>固定过渡</accent> - 预设会将其过渡（运动部分）保存为固定时长，而将保持段保存为可变，因此应用的预设无论片段长短都能保持相同的感觉。"
          }
        }
      }
    },
    "<accent>Intervals</accent> - the gap between two keyposes. Each carries its own easing curve and optional modulation. Link the endpoints to make the interval a flat hold.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Intervalle</accent> - der Abstand zwischen zwei Keyposes. Jedes hat seine eigene Beschleunigungskurve und optionale Modulation. Verknüpfe die Endpunkte, um aus dem Intervall ein flaches Halten zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Intervalos</accent> - el espacio entre dos keyposes. Cada uno tiene su propia curva de aceleración y modulación opcional. Vincula los extremos para convertir el intervalo en un mantenimiento plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Intervalles</accent> - l'espace entre deux keyposes. Chacun a sa propre courbe d'accélération et une modulation facultative. Liez les extrémités pour transformer l'intervalle en un maintien constant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>区間</accent> - 2つのキーポーズの間。各区間は独自のイージングカーブと任意のモジュレーションを持ちます。端点をリンクすると区間は平坦な保持になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>구간</accent> - 두 키포즈 사이의 간격. 각 구간은 고유한 이징 커브와 선택적 모듈레이션을 가집니다. 끝점을 연결하면 구간이 평평한 유지가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>区间</accent> - 两个关键姿势之间的间隔。每个区间都有自己的缓动曲线和可选调制。链接两端可使区间成为平直的保持。"
          }
        }
      }
    },
    "<accent>Keyposes</accent> - a value at a point in time, shown as a pill on the lane. Place them wherever the motion should pass through.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Keyposes</accent> - ein Wert zu einem Zeitpunkt, als Pille auf der Spur dargestellt. Platziere sie dort, wo die Bewegung hindurchlaufen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Keyposes</accent> - un valor en un punto en el tiempo, mostrado como una píldora en el carril. Colócalos allí donde el movimiento deba pasar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Keyposes</accent> - une valeur à un instant donné, affichée comme une pastille sur la piste. Placez-les là où le mouvement doit passer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>キーポーズ</accent> - ある時点の値で、レーン上にピルとして表示されます。動きを通したい位置に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>키포즈</accent> - 한 시점의 값으로, 레인에 알약 모양으로 표시됩니다. 움직임이 지나가야 할 위치에 배치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>关键姿势</accent> - 某个时间点上的值，在轨道上显示为药丸。将其放在运动应当经过的位置。"
          }
        }
      }
    },
    "<accent>Lanes</accent> - one per animatable property (Position, Radius, Color...). Toggle a lane on to animate it, off to hold a constant. The lane list is on the left.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Spuren</accent> - eine pro animierbarer Eigenschaft (Position, Radius, Farbe...). Schalte eine Spur ein, um sie zu animieren, aus, um einen konstanten Wert zu halten. Die Spurenliste ist links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Carriles</accent> - uno por propiedad animable (Posición, Radio, Color...). Activa un carril para animarlo, desactívalo para mantener un valor constante. La lista de carriles está a la izquierda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Pistes</accent> - une par propriété animable (Position, Rayon, Couleur...). Activez une piste pour l'animer, désactivez-la pour garder une valeur constante. La liste des pistes est à gauche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>レーン</accent> - アニメーション可能なプロパティごとに1つ(位置、半径、カラーなど)。レーンをオンにするとアニメーション、オフにすると一定値を保持。レーンリストは左側にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>레인</accent> - 애니메이션 가능한 속성마다 하나씩(위치, 반지름, 색상 등). 레인을 켜면 애니메이션, 끄면 상수 값을 유지합니다. 레인 목록은 왼쪽에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>轨道</accent> - 每个可动画属性一条(位置、半径、颜色等)。打开轨道即可制作动画，关闭则保持恒定值。轨道列表在左侧。"
          }
        }
      }
    },
    "<accent>Linear</accent> - uniform motion.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Linear</accent> - gleichmäßige Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Lineal</accent> - movimiento uniforme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Linéaire</accent> - mouvement uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>リニア</accent> - 一定の動き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>선형</accent> - 균일한 움직임."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>线性</accent> - 匀速运动。"
          }
        }
      }
    },
    "<accent>Manage</accent> - rename, overwrite with the current animation, or delete your own presets (built-ins can't be changed).": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Verwalten</accent> - benennen Sie Ihre eigenen Presets um, überschreiben Sie sie mit der aktuellen Animation oder löschen Sie sie (integrierte lassen sich nicht ändern)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Gestionar</accent> - cambia el nombre de tus preajustes, sobrescríbelos con la animación actual o elimínalos (los integrados no se pueden cambiar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Gérer</accent> - renommez vos préréglages, remplacez-les par l'animation actuelle ou supprimez-les (les intégrés ne sont pas modifiables)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>管理</accent> - 自分のプリセットの名前を変更したり、現在のアニメーションで上書きしたり、削除したりできます（組み込みは変更できません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>관리</accent> - 내 프리셋의 이름을 변경하거나 현재 애니메이션으로 덮어쓰거나 삭제할 수 있습니다(기본 제공 항목은 변경할 수 없습니다)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>管理</accent> - 重命名、用当前动画覆盖或删除你自己的预设（内置预设无法更改）。"
          }
        }
      }
    },
    "<accent>Samples</accent>: 2 to 128, default 16. Higher gives smoother blur at the cost of render time; the useful range is roughly 2 to 32.": {
      "comment": "Help tip (motion blur).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Samples</accent>: 2 bis 128, Standard 16. Höhere Werte ergeben weichere Unschärfe auf Kosten der Renderzeit; der sinnvolle Bereich liegt etwa bei 2 bis 32."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Muestras</accent>: de 2 a 128, predeterminado 16. Más muestras dan un desenfoque más suave a costa del tiempo de render; el rango útil es aproximadamente de 2 a 32."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Échantillons</accent> : de 2 à 128, par défaut 16. Une valeur plus élevée donne un flou plus lisse au prix du temps de rendu ; la plage utile va environ de 2 à 32."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>サンプル</accent>: 2～128、デフォルトは16。値を上げるとブラーは滑らかになりますがレンダリング時間が増えます。実用的な範囲はおよそ2～32です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>샘플</accent>: 2에서 128까지, 기본값 16. 값이 높을수록 블러가 부드러워지지만 렌더링 시간이 늘어납니다. 유용한 범위는 대략 2에서 32입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>采样</accent>：2至128，默认16。数值越高模糊越平滑，但渲染时间越长；实用范围大约为2至32。"
          }
        }
      }
    },
    "<accent>Save</accent> - type a name in the field and press <kbd>+</kbd> to save the current animation as your own preset.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Sichern</accent> - geben Sie einen Namen in das Feld ein und drücken Sie <kbd>+</kbd>, um die aktuelle Animation als eigenes Preset zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Guardar</accent> - escribe un nombre en el campo y pulsa <kbd>+</kbd> para guardar la animación actual como tu propio preajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Enregistrer</accent> - saisissez un nom dans le champ et appuyez sur <kbd>+</kbd> pour enregistrer l'animation actuelle comme votre propre préréglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>保存</accent> - フィールドに名前を入力し、<kbd>+</kbd> を押すと、現在のアニメーションを自分のプリセットとして保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>저장</accent> - 필드에 이름을 입력하고 <kbd>+</kbd>를 누르면 현재 애니메이션을 내 프리셋으로 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>保存</accent> - 在字段中输入名称并按 <kbd>+</kbd>，即可将当前动画保存为你自己的预设。"
          }
        }
      }
    },
    "<accent>Shutter</accent>: 0° to 360°, default 180°. 0° freezes each frame with no blur, 180° is a half-frame trail (the cinema-standard 180-degree shutter), 360° smears across a full frame interval.": {
      "comment": "Help tip (motion blur).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Verschluss</accent>: 0° bis 360°, Standard 180°. 0° friert jedes Bild ohne Unschärfe ein, 180° erzeugt eine Halbbild-Spur (der kinotypische 180-Grad-Verschluss), 360° verschmiert über ein ganzes Bildintervall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Obturador</accent>: de 0° a 360°, predeterminado 180°. 0° congela cada fotograma sin desenfoque, 180° deja una estela de medio fotograma (el obturador de 180 grados estándar del cine), 360° difumina a lo largo de un intervalo de fotograma completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Obturateur</accent> : de 0° à 360°, par défaut 180°. 0° fige chaque image sans flou, 180° laisse une traînée d'une demi-image (l'obturateur à 180 degrés standard au cinéma), 360° étale sur un intervalle d'image complet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>シャッター</accent>: 0°～360°、デフォルトは180°。0°はブラーなしで各フレームを静止させ、180°は半フレームの軌跡(映画標準の180度シャッター)、360°は1フレーム分の間隔全体に伸ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>셔터</accent>: 0°에서 360°까지, 기본값 180°. 0°는 블러 없이 각 프레임을 고정하고, 180°는 반 프레임 궤적(영화 표준 180도 셔터), 360°는 한 프레임 간격 전체에 번지게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>快门</accent>：0°至360°，默认180°。0°冻结每一帧且无模糊，180°是半帧拖尾(电影标准的180度快门)，360°在整帧间隔内拖出残影。"
          }
        }
      }
    },
    "<accent>Transitions only</accent> (default): blur only when the keypose values differ, i.e. during actual motion.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Nur Übergänge</accent> (Standard): Unschärfe nur, wenn sich die Keypose-Werte unterscheiden, also während tatsächlicher Bewegung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Solo transiciones</accent> (predeterminado): desenfoque solo cuando los valores de keypose difieren, es decir, durante el movimiento real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Transitions uniquement</accent> (par défaut) : flou seulement lorsque les valeurs des keyposes diffèrent, c'est-à-dire pendant un mouvement réel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>トランジションのみ</accent>(デフォルト): キーポーズの値が異なるとき、つまり実際の動きの間だけブラーをかけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>전환만</accent>(기본값): 키포즈 값이 다를 때, 즉 실제 움직임이 있는 동안에만 블러를 적용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>仅过渡</accent>(默认)：仅当关键姿势的值不同时(即实际运动期间)才模糊。"
          }
        }
      }
    },
    "<accent>Value changes</accent>: blur whenever any value moves, including subtle modulation on held intervals.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Wertänderungen</accent>: Unschärfe, sobald sich ein Wert bewegt, einschließlich subtiler Modulation auf gehaltenen Intervallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Cambios de valor</accent>: desenfoque siempre que un valor se mueva, incluida la modulación sutil en intervalos mantenidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Changements de valeur</accent> : flou dès qu'une valeur bouge, y compris une modulation subtile sur les intervalles maintenus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>値の変化</accent>: 保持された区間での微妙なモジュレーションを含め、いずれかの値が動くたびにブラーをかけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>값 변경</accent>: 유지된 구간의 미묘한 모듈레이션을 포함해 값이 움직일 때마다 블러를 적용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>值变化</accent>：只要任何值发生移动就模糊，包括保持区间上的细微调制。"
          }
        }
      }
    },
    "<accent>When</accent>: a dropdown that controls when the blur is applied:": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Wann</accent>: ein Aufklappmenü, das steuert, wann die Unschärfe angewendet wird:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
