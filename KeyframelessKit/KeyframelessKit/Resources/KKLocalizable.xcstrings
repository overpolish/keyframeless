    "<accent>Elastic</accent> - overshoots and oscillates before settling.": {
      "comment": "Help text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Elastisch</accent> - schießt über und schwingt, bevor es sich einpendelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Elástico</accent> - se pasa y oscila antes de estabilizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>Élastique</accent> - dépasse et oscille avant de se stabiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>エラスティック</accent> - 行き過ぎて振動してから落ち着く。"
          }
