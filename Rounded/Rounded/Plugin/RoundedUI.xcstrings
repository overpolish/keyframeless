    "Drag a Radius keypose toward the <warn>glowing target</warn>": {
      "comment": "Advanced timing guide: drag a Radius keypose.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Radius-Keypose zum <warn>leuchtenden Ziel</warn>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个半径关键姿势拖向<warn>发光目标</warn>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une pose clé de Rayon vers la <warn>cible lumineuse</warn>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径のキーポーズを<warn>光るターゲット</warn>に向かってドラッグします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반지름 키포즈를 <warn>빛나는 대상</warn> 쪽으로 드래그하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una pose clave de Radio hacia la <warn>diana luminosa</warn>"
          }
        }
      }
    },
    "Drag the <accent>diamond</accent> toward the <warn>glowing target</warn> (0.8s)": {
      "comment": "Basic timing guide: drag a keypose diamond to a target time.",
