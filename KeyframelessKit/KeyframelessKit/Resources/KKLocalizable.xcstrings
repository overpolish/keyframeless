    "Each <accent>pill</accent> is a keypose, a value at a moment in time. Click one to edit it.": {
      "comment": "Timing guide: edit a keypose pill.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede <accent>Kapsel</accent> ist eine Keypose, ein Wert zu einem Zeitpunkt. Klicken Sie auf eine, um sie zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada <accent>cápsula</accent> es una pose clave, un valor en un momento concreto. Haz clic en una para editarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque <accent>pastille</accent> est une pose clé, une valeur à un instant donné. Cliquez sur l'une d'elles pour la modifier."
          }
        },
        "ja": {
