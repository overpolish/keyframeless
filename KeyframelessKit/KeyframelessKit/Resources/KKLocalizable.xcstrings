    "Update available": {
      "comment": "Update banner, no version known",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update verfügbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour disponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが利用可能"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 사용 가능"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有可用更新"
          }
        }
      }
    },
    "Use the <accent>mini viewer</accent> to edit a keypose at its point in time, without scrubbing the timeline there.": {
      "comment": "Mini-viewer guide: closing benefit step.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem <accent>Mini-Viewer</accent> bearbeiten Sie eine Keypose zu ihrem Zeitpunkt, ohne in der Timeline dorthin zu scrubben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el <accent>mini-visor</accent> para editar una pose clave en su momento exacto, sin desplazarte por la línea de tiempo hasta ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la <accent>mini-visionneuse</accent> pour modifier une pose clé à son instant précis, sans parcourir la timeline jusque-là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>ミニビューア</accent>を使えば、タイムラインをスクラブせずに、キーポーズをその時点で編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>미니 뷰어</accent>를 사용하면 타임라인을 스크러빙하지 않고도 키포즈를 해당 시점에서 편집할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用<accent>迷你检视器</accent>，无需在时间线上拖动到该处，即可在某个时间点编辑关键姿势。"
          }
        }
      }
    },
    "Values you don't animate stay <accent>constant</accent>. Open the <accent>Constants</accent> panel to edit them.": {
      "comment": "Timing guide: open the Constants panel.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte, die Sie nicht animieren, bleiben <accent>konstant</accent>. Öffnen Sie das Feld <accent>Konstanten</accent>, um sie zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores que no animas permanecen <accent>constantes</accent>. Abre el panel <accent>Constantes</accent> para editarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs que vous n'animez pas restent <accent>constantes</accent>. Ouvrez le panneau <accent>Constantes</accent> pour les modifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメートしない値は<accent>一定</accent>のままです。<accent>定数</accent>パネルを開いて編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션하지 않는 값은 <accent>일정하게</accent> 유지됩니다. <accent>상수</accent> 패널을 열어 편집하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未制作动画的值保持<accent>恒定</accent>。打开<accent>常量</accent>面板进行编辑。"
          }
        }
      }
    },
    "Watch it back: press <symbol play.fill color=accent />.": {
      "comment": "Timing guide: play the animation back.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie es sich an: Drücken Sie <symbol play.fill color=accent />."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodúcelo: pulsa <symbol play.fill color=accent />."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visionnez le résultat : appuyez sur <symbol play.fill color=accent />."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生して確認しましょう：<symbol play.fill color=accent /> を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 재생해 보세요: <symbol play.fill color=accent />을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回放查看：按 <symbol play.fill color=accent />。"
          }
        }
      }
    },
    "What's New": {
