            "value": "グローを脈動させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광채를 맥동시키기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让辉光脉动"
          }
        }
      }
    },
    "Pulse the glow larger and back a few times across the clip.": {
      "comment": "AI example value: pulse the glow.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Leuchten über den Clip hinweg ein paar Mal größer und wieder kleiner pulsieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que el resplandor pulse haciéndose más grande y volviendo varias veces a lo largo del clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais pulser la lueur en l'agrandissant et en la réduisant plusieurs fois sur la durée du plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップ全体でグローを数回、大きくしては戻して脈動させる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립 전체에서 광채가 몇 번 커졌다 돌아오며 맥동하게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让辉光在整个片段中放大并缩回，脉动几次。"
          }
        }
      }
    },
    "What's Basic vs Advanced?": {
