{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/KeyframelessKit/**",
        "${workspaceFolder}/Canvas/**",
        "${workspaceFolder}/CanvasRenderer/**",
        "${workspaceFolder}/MagicMove/**",
        "${workspaceFolder}/Glow/**",
        "${workspaceFolder}/Rounded/**",
        "${workspaceFolder}/MotionTemplates/**",
        "${workspaceFolder}/Template/**",
        "${workspaceFolder}/Keyframeless X/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/KeyframelessKit",
          "${workspaceFolder}/Canvas",
          "${workspaceFolder}/CanvasRenderer",
          "${workspaceFolder}/MagicMove",
          "${workspaceFolder}/Glow",
          "${workspaceFolder}/Rounded",
          "${workspaceFolder}/MotionTemplates",
          "${workspaceFolder}/Template",
          "${workspaceFolder}/Keyframeless X"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [],
      "macFrameworkPath": [
        "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks",
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks",
        "/System/Library/Frameworks"
      ],
      "compilerPath": "/usr/bin/clang",
      "compilerArgs": ["-fmodules"],
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ],
  "version": 4
}
