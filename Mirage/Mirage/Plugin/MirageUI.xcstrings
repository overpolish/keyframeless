          "stringUnit": {
            "state": "translated",
            "value": "2–4 Zahlen in einem Steuerelement, z. B. Größe oder Versatz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2-4 números en un control, como un tamaño o desplazamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 à 4 nombres dans une commande, comme une taille ou un décalage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのコントロールに2〜4個の数値。サイズやオフセットなど。"
