    "Reveal the stroke of the selected path by animating its draw-on from nothing to fully drawn across the clip.": {
      "comment": "AI example value: draw on the stroke.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende die Kontur des ausgewählten Pfades ein, indem du sein Draw-On über den Clip von nichts bis vollständig gezeichnet animierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revela el trazo del trazado seleccionado animando su draw-on de nada a completamente dibujado a lo largo del clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révélez le contour du tracé sélectionné en animant son draw-on de rien à entièrement tracé sur la durée du plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したパスの線を、クリップ全体で描画（draw-on）を何もない状態から完全に描かれた状態までアニメーションして表示して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 패스의 획을 클립 전체에 걸쳐 그리기(draw-on)를 0에서 완전히 그려진 상태까지 애니메이션해서 드러내 줘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过在整个片段中将所选路径的绘制（draw-on）从无到完全绘出来显现其描边。"
          }
        }
      }
    },
