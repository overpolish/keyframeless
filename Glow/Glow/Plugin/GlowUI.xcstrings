          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移半径环"
          }
        }
      }
    },
    "Set the glow size on the canvas": {
      "comment": "Help shortcut.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größe des Leuchtens auf der Arbeitsfläche festlegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el tamaño del resplandor en el lienzo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir la taille de la lueur sur le canevas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス上でグローの大きさを設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에서 광채 크기 설정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上设置辉光大小"
          }
        }
      }
    },
    "On-screen control shortcuts": {
      "comment": "Help section title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle für Bildschirmsteuerung"
          }
        },
        "es": {
