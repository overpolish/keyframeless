      }
    },
    "`#slots` needs max=1 to %d, the most instances a group can have": {
      "comment": "Mirage slots max error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` braucht max=1 bis %d, so viele Instanzen kann eine Gruppe höchstens haben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` necesita max=1 a %d, el máximo de instancias que puede tener un grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` a besoin de max=1 à %d, le nombre maximal d’instances d’un groupe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` には max=1〜%d が必要です。グループが持てるインスタンスの上限です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots`에는 max=1에서 %d까지가 필요합니다. 그룹이 가질 수 있는 최대 인스턴스 수입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` 需要 max=1 到 %d，这是一个组最多可有的实例数"
          }
        }
      }
    },
    "`#slots` needs a `// #slots-end` to close the group": {
      "comment": "Mirage unclosed slots block error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` braucht ein `// #slots-end`, um die Gruppe zu schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` necesita un `// #slots-end` que cierre el grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#slots` a besoin d’un `// #slots-end` pour fermer le groupe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
