{
  "sourceLanguage": "en",
  "strings": {
    "Auto grid spacing": {
      "comment": "Toolbar tooltip: automatic grid spacing",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatischer Rasterabstand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaciado automático de cuadrícula"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacement automatique de la grille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド間隔を自動調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 격자 간격"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动网格间距"
          }
        }
      }
    },
    "Auto-select layers": {
      "comment": "Companion-panel toggle: click a layer in the viewer to select it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebenen automatisch auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección automática de capas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection automatique des calques"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーを自動選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 자동 선택"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择图层"
          }
        }
      }
    },
    "Click a layer in the viewer to select it.": {
      "comment": "Tooltip for the Auto-select layers toggle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Viewer auf eine Ebene, um sie auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una capa del visor para seleccionarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un calque dans le visualiseur pour le sélectionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューアでレイヤーをクリックして選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰어에서 레이어를 클릭하여 선택합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在检视器中点按图层以将其选中。"
          }
        }
      }
    },
    "Complex path - too many points to edit by hand, so it moves and scales like an image.": {
      "comment": "Layer-list tooltip for an oversized (non-point-editable) path",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplexer Pfad - zu viele Punkte zum manuellen Bearbeiten, daher wird er wie ein Bild bewegt und skaliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazado complejo: demasiados puntos para editarlo a mano, así que se mueve y escala como una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracé complexe - trop de points pour une édition manuelle, il se déplace et se redimensionne donc comme une image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑なパス - 手作業で編集するには点が多すぎるため、画像のように移動・拡大縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 패스 - 손으로 편집하기에 점이 너무 많아 이미지처럼 이동하고 크기를 조절합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复杂路径 - 锚点过多无法手动编辑，因此像图像一样移动和缩放。"
          }
        }
      }
    },
    "Delete": {
      "comment": "Layer context menu.",
      "extractionState": "manual",
      "localizations": {
