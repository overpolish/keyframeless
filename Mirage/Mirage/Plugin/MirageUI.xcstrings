    "Use exactly one `#frames` directive in the Image shader": {
      "comment": "Mirage duplicate frames directive error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende genau eine `#frames`-Direktive im Image-Shader"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente una directiva `#frames` en el shader Image"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’utilisez qu’une seule directive `#frames` dans le shader Image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Image シェーダーでは `#frames` ディレクティブをちょうど 1 つ使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Image 셰이더에는 `#frames` 지시문을 정확히 하나만 사용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Image 着色器中只能使用一条 `#frames` 指令"
          }
        }
      }
    },
    "`#frames` needs offsets=\"-1,+1\", a comma-separated list of whole frames": {
      "comment": "Mirage frames directive missing-offsets error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` benötigt offsets=\"-1,+1\", eine kommagetrennte Liste ganzer Frames"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` necesita offsets=\"-1,+1\", una lista de fotogramas enteros separados por comas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` exige offsets=\"-1,+1\", une liste d’images entières séparées par des virgules"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` には offsets=\"-1,+1\" が必要です。カンマ区切りの整数フレームで指定してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames`에는 offsets=\"-1,+1\"이 필요합니다. 쉼표로 구분한 정수 프레임 목록을 지정하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 需要 offsets=\"-1,+1\"，即以逗号分隔的整数帧列表"
          }
        }
      }
    },
    "`#frames` offsets must be whole frames, like offsets=\"-2,-1,+1\"": {
      "comment": "Mirage frames directive malformed-offset error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames`-Offsets müssen ganze Frames sein, etwa offsets=\"-2,-1,+1\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los desplazamientos de `#frames` deben ser fotogramas enteros, como offsets=\"-2,-1,+1\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décalages de `#frames` doivent être des images entières, comme offsets=\"-2,-1,+1\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` のオフセットは offsets=\"-2,-1,+1\" のような整数フレームで指定してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 오프셋은 offsets=\"-2,-1,+1\"처럼 정수 프레임이어야 합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 的偏移必须是整数帧，例如 offsets=\"-2,-1,+1\""
          }
        }
      }
    },
    "`#frames` offset 0 is the current frame - read that from iChannel0": {
      "comment": "Mirage frames directive zero-offset error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der `#frames`-Offset 0 ist der aktuelle Frame – lies ihn über iChannel0"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento 0 de `#frames` es el fotograma actual: léelo desde iChannel0"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décalage 0 de `#frames` est l’image actuelle : lisez-la depuis iChannel0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` のオフセット 0 は現在のフレームです。iChannel0 から読み取ってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 오프셋 0은 현재 프레임입니다. iChannel0에서 읽으세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 偏移 0 就是当前帧，请改从 iChannel0 读取"
          }
        }
      }
    },
    "`#frames` lists the same offset twice - each offset binds its own iNeighbor slot": {
      "comment": "Mirage frames directive duplicate-offset error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` nennt denselben Offset zweimal – jeder Offset belegt seinen eigenen iNeighbor-Slot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` repite el mismo desplazamiento: cada uno ocupa su propia ranura iNeighbor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` répète le même décalage : chacun occupe son propre emplacement iNeighbor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` に同じオフセットが 2 回あります。各オフセットはそれぞれの iNeighbor スロットに割り当てられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames`에 같은 오프셋이 두 번 있습니다. 각 오프셋은 고유한 iNeighbor 슬롯에 연결됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 中同一偏移出现了两次，每个偏移各占一个 iNeighbor 插槽"
          }
        }
      }
    },
    "`#frames` takes at most %d offsets - each one is another full frame in memory": {
      "comment": "Mirage frames directive offset-count error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` erlaubt höchstens %d Offsets – jeder ist ein weiterer vollständiger Frame im Speicher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` admite como máximo %d desplazamientos: cada uno es otro fotograma completo en memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` accepte au maximum %d décalages : chacun représente une image complète de plus en mémoire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` のオフセットは最大 %d 個です。1 つにつきフレーム 1 枚分のメモリを消費します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames`는 오프셋을 최대 %d개까지 받습니다. 하나마다 프레임 한 장이 메모리에 더 올라갑니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#frames` 最多接受 %d 个偏移，每个偏移都会在内存中多占用一整帧"
          }
        }
      }
    },
    "Also deliver the clip at other frames, for trails and other effects that read across time.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liefert den Clip zusätzlich zu anderen Frames – für Spuren und andere Effekte, die über die Zeit lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega también el clip en otros fotogramas, para estelas y otros efectos que leen a lo largo del tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit aussi le plan à d’autres images, pour les traînées et les effets qui lisent dans le temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のフレームのクリップも受け取ります。時間をまたいで読み取る軌跡などの効果に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 프레임의 클립도 전달합니다. 시간을 가로질러 읽는 잔상 등의 효과에 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时提供其他帧的片段，可用于拖尾等需要跨时间读取的效果。"
          }
        }
      }
    },
    "#frames: which frames to deliver, signed and relative to this one, like \"-2,-1,+1\".": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames: welche Frames geliefert werden – vorzeichenbehaftet und relativ zu diesem, etwa \"-2,-1,+1\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames: qué fotogramas entregar, con signo y relativos a este, como \"-2,-1,+1\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames : quelles images fournir, signées et relatives à celle-ci, comme \"-2,-1,+1\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames: 受け取るフレーム。このフレームからの符号付き相対値で、例えば \"-2,-1,+1\" のように指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames: 전달할 프레임. 현재 프레임 기준의 부호 있는 상대값이며 예를 들어 \"-2,-1,+1\"입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#frames：要提供哪些帧，为相对当前帧的带符号数值，例如 \"-2,-1,+1\"。"
          }
        }
      }
    },
    "The source clip at the i-th frame offset declared by #frames, sampled at uv.": {
