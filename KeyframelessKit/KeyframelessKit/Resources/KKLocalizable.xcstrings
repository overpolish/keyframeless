    "Your current sequence isn't compatible with Basic mode.": {
      "comment": "Alert message when switching timeline to Basic mode.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Sequenz ist nicht mit dem einfachen Modus kompatibel."
