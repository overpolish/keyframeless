    "Apply on an Adjustment Clip <kbd>⌥ A</kbd> or a Compound Clip <kbd>⌥ G</kbd> to avoid unexpected behavior and clipping.": {
      "comment": "Help tip: wrap the clip.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende den Effekt auf einen Anpassungsclip <kbd>⌥ A</kbd> oder einen Compound-Clip <kbd>⌥ G</kbd> an, um unerwartetes Verhalten und Beschneiden zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplícalo en un clip de ajuste <kbd>⌥ A</kbd> o en un clip compuesto <kbd>⌥ G</kbd> para evitar comportamientos inesperados y recortes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquez-le sur un plan d'ajustement <kbd>⌥ A</kbd> ou un plan composé <kbd>⌥ G</kbd> pour éviter les comportements inattendus et le rognage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しない動作やクリッピングを避けるため、調整クリップ <kbd>⌥ A</kbd> またはコンパウンドクリップ <kbd>⌥ G</kbd> に適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상치 못한 동작과 잘림을 피하려면 조정 클립 <kbd>⌥ A</kbd> 또는 컴파운드 클립 <kbd>⌥ G</kbd> 에 적용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请应用在调整片段 <kbd>⌥ A</kbd> 或复合片段 <kbd>⌥ G</kbd> 上，以避免意外行为和裁剪。"
          }
        }
      }
    },
