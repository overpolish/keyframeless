#!/bin/bash
# Generated by scripts/split-pkgproj.py from scripts/uninstall.template - do not edit.
#
# Per-plugin uninstaller: removes ONLY this plugin. Other Keyframeless plugins are
# left alone; the shared folders are removed only if this was the last one.

PLUGIN="__PLUGIN_NAME__"
APP_DIR="/Applications/Keyframeless"
APP="$APP_DIR/__APP_NAME__"
TEMPLATES_DIR="$HOME/Movies/Motion Templates.localized/Effects.localized/Keyframeless"
TEMPLATE_NAME="__TEMPLATE_NAME__"
TEMPLATE=""
[ -n "$TEMPLATE_NAME" ] && TEMPLATE="$TEMPLATES_DIR/$TEMPLATE_NAME"

echo "$PLUGIN Uninstaller"
echo "=============================="
echo ""
echo "Removes $PLUGIN only. Your other Keyframeless plugins are untouched."
echo ""

echo "The following will be deleted:"
[ -e "$APP" ] && echo "  $APP"
[ -n "$TEMPLATE" ] && [ -e "$TEMPLATE" ] && echo "  $TEMPLATE"
if [ ! -e "$APP" ] && { [ -z "$TEMPLATE" ] || [ ! -e "$TEMPLATE" ]; }; then
    echo "  (nothing - $PLUGIN is already uninstalled)"
    sleep 2
    osascript -e 'tell application "Terminal" to close front window' &
    exit 0
fi
echo ""

read -p "Continue? (y/n) " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Uninstall cancelled."
    exit 0
fi

if [ -n "$TEMPLATE" ] && [ -e "$TEMPLATE" ]; then
    rm -rf "$TEMPLATE"
    echo "Removed $PLUGIN template."
fi
if [ -e "$APP" ]; then
    sudo rm -rf "$APP"
    echo "Removed $PLUGIN app."
fi

# Drop this uninstaller, then clear the shared folders only if now empty
# (other installed plugins keep them populated, so they survive).
sudo rm -f "$APP_DIR/Uninstall $PLUGIN"
rmdir "$TEMPLATES_DIR" 2>/dev/null
sudo rmdir "$APP_DIR" 2>/dev/null

echo ""
echo "$PLUGIN uninstalled. Restart Motion / Final Cut Pro for the change to take effect."
sleep 2
osascript -e 'tell application "Terminal" to close front window' &
