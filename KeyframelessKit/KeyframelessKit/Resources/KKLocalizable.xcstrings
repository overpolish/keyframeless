    "Plugins don't animate by default. Tap <symbol plus.circle.fill color=accent /> to give a property a lane.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug-ins animieren standardmäßig nicht. Tippen Sie auf <symbol plus.circle.fill color=accent />, um einer Eigenschaft eine Spur zu geben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plug-ins ne s'animent pas par défaut. Touchez <symbol plus.circle.fill color=accent /> pour donner une piste à une propriété."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins no se animan por omisión. Toca <symbol plus.circle.fill color=accent /> para dar una pista a una propiedad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインはデフォルトではアニメートしません。<symbol plus.circle.fill color=accent /> をタップして、プロパティにレーンを与えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 기본적으로 애니메이션하지 않습니다. <symbol plus.circle.fill color=accent />을 탭하여 속성에 레인을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件默认不制作动画。轻点 <symbol plus.circle.fill color=accent /> 为属性添加一条轨道。"
