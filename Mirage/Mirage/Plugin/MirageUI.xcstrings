    },
    "The sampled hue in degrees, in this control's own convention.": {
      "comment": "Mirage code-editor autocomplete: the help line shown for a directive, GLSL or OSC item.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
