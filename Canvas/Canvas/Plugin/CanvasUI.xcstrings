    "Sketch roughens both the outline and the fill, so the whole layer looks hand-drawn.": {
      "comment": "Canvas help tip (from AIKnowledge markdown).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch raut sowohl den Umriss als auch die Füllung auf, sodass die ganze Ebene handgezeichnet wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch da rugosidad tanto al contorno como al relleno, así que toda la capa parece dibujada a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch rugosifie à la fois le contour et le remplissage, si bien que tout le calque paraît dessiné à la main."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch は輪郭と塗りつぶしの両方を粗くするので、レイヤー全体が手描きのように見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch는 윤곽과 채우기를 모두 거칠게 만들어 레이어 전체가 손으로 그린 것처럼 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch 会让轮廓和填充都变粗糙，因此整个图层看起来都像手绘。"
          }
        }
      }
    },
