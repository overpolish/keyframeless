#!/bin/bash
# Generated by scripts/split-pkgproj.py from scripts/uninstall.template - do not edit.
#
# Per-plugin uninstaller: removes ONLY this plugin. Other Keyframeless plugins are
# left alone; the shared folders are removed only if this was the last one.

PLUGIN="__PLUGIN_NAME__"
APP_DIR="/Applications/Keyframeless"
APP="$APP_DIR/__APP_NAME__"
MOTION_BASE="$HOME/Movies/Motion Templates.localized"

# One entry per template this plugin installs, each relative to MOTION_BASE
# (e.g. "Effects.localized/Keyframeless/Shader • KF"). A plugin can ship more than
# one type (effect + transition), so this is a list, not a single path. Empty for
# products with no templates (the workflow extension).
TEMPLATE_RELPATHS=(
__TEMPLATE_RELPATHS__
)

TEMPLATES=()
for rel in "${TEMPLATE_RELPATHS[@]}"; do
    [ -n "$rel" ] && TEMPLATES+=("$MOTION_BASE/$rel")
done

echo "$PLUGIN Uninstaller"
echo "=============================="
echo ""
echo "Removes $PLUGIN only. Your other Keyframeless plugins are untouched."
echo ""

ANY_TEMPLATE=0
for t in "${TEMPLATES[@]}"; do
    [ -e "$t" ] && ANY_TEMPLATE=1
done

echo "The following will be deleted:"
[ -e "$APP" ] && echo "  $APP"
for t in "${TEMPLATES[@]}"; do
    [ -e "$t" ] && echo "  $t"
done
if [ ! -e "$APP" ] && [ "$ANY_TEMPLATE" -eq 0 ]; then
    echo "  (nothing - $PLUGIN is already uninstalled)"
    sleep 2
    osascript -e 'tell application "Terminal" to close front window' &
    exit 0
fi
echo ""

read -p "Continue? (y/n) " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Uninstall cancelled."
    exit 0
fi

for t in "${TEMPLATES[@]}"; do
    if [ -e "$t" ]; then
        rm -rf "$t"
        echo "Removed $PLUGIN template."
    fi
done
if [ -e "$APP" ]; then
    sudo rm -rf "$APP"
    echo "Removed $PLUGIN app."
fi

# Drop this uninstaller, then clear the shared folders only if now empty (other
# installed plugins keep them populated, so they survive). Each template's parent
# is a "<Type>.localized/Keyframeless" folder shared with the other plugins.
sudo rm -f "$APP_DIR/Uninstall $PLUGIN"
for t in "${TEMPLATES[@]}"; do
    rmdir "$(dirname "$t")" 2>/dev/null
done
sudo rmdir "$APP_DIR" 2>/dev/null

echo ""
echo "$PLUGIN uninstalled. Restart Motion / Final Cut Pro for the change to take effect."
sleep 2
osascript -e 'tell application "Terminal" to close front window' &
