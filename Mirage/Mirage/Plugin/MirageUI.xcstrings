    "Two `#slots` groups named \"%@\": give each group its own name": {
      "comment": "Mirage duplicate slots name error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei `#slots`-Gruppen heißen „%@“: gib jeder Gruppe einen eigenen Namen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos grupos `#slots` se llaman «%@»: da a cada grupo su propio nombre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux groupes `#slots` s’appellent « %@ » : donnez à chaque groupe son propre nom"
