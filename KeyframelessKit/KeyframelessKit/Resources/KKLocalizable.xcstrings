    "Wiggle": {
      "comment": "Hold modulation name.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wackeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bamboleo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
