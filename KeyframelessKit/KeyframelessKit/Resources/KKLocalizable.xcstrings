{
  "sourceLanguage": "en",
  "strings": {
    "<kbd>⌘ click</kbd> the lane to add a <accent>keypose</accent>.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌘ Klick</kbd> auf die Spur, um eine <accent>Keypose</accent> hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌘ clic</kbd> sur la piste pour ajouter une <accent>pose clé</accent>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌘ clic</kbd> en la pista para añadir una <accent>pose clave</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンを<kbd>⌘ クリック</kbd>して<accent>キーポーズ</accent>を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레인을 <kbd>⌘ 클릭</kbd>하여 <accent>키포즈</accent>를 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "<kbd>⌘ 点击</kbd>轨道以添加<accent>关键姿势</accent>。"
          }
        }
      },
      "comment": "Advanced timing guide: add a keypose to a lane."
    },
    "Add <accent>%@</accent>.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>%@</accent> hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter <accent>%@</accent>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir <accent>%@</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>%@</accent>を追加。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>%@</accent> 추가."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加<accent>%@</accent>。"
          }
        }
      },
      "comment": "Timing guide: add the named property. %@ = property name."
    },
    "Add Keypose Here": {
      "comment": "Context menu: add a keypose at this point.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keypose hier hinzufügen"
