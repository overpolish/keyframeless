    "Turn <accent>In</accent> on so the line eases on from the start.": {
      "comment": "Arrow guide: enable the In transition.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte <accent>Ein</accent> ein, damit die Linie von Anfang an sanft entsteht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa <accent>Entrada</accent> para que la línea aparezca suavemente desde el inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active <accent>Entrée</accent> pour que la ligne apparaisse en douceur dès le début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>イン</accent>をオンにすると、線が最初からなめらかに現れます。"
          }
        },
        "ko": {
