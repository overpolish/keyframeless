          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミングのショートカット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 단축키"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
