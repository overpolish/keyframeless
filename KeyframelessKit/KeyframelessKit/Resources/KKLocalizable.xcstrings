    "Turn <accent>In</accent> on to ease into the value from the start.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie <accent>Ein</accent> ein, um vom Anfang an sanft in den Wert überzugehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez <accent>Entrée</accent> pour entrer progressivement dans la valeur dès le début."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa <accent>Entrada</accent> para entrar suavemente en el valor desde el inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>イン</accent>をオンにすると、最初から値へなめらかに変化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>인</accent>을 켜면 시작부터 값으로 부드럽게 전환됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开<accent>进入</accent>，从开头平滑过渡到该值。"
          }
