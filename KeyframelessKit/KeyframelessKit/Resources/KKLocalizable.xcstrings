    "Elastic and Bounce add Intensity and Frequency controls to dial in the wobble.": {
      "comment": "Help tip rendered from a timeline knowledge doc.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elastisch und Abprallen fügen Regler für Intensität und Frequenz hinzu, um das Schwingen einzustellen."
          }
        },
        "es": {
          "stringUnit": {
