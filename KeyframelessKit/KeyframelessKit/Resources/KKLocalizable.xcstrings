        }
      }
    },
    "Tap <accent>Onion</accent> to stack the frames.": {
      "extractionState": "manual",
      "comment": "Mini-viewer guide: switch to onion-skin mode.",
      "localizations": {
        "de": {
          "stringUnit": {
