CompileFlags:
  Add:
    - -fobjc-arc
    - -fmodules
    - -fcxx-modules
    - -fmodule-name=KeyframelessKit
    - -fmodules-cache-path=/tmp/clangd-modules-cache
    - -F<PATH_TO_REPO>/DerivedData/Keyframeless/Build/Products/Debug
    - -F/Library/Developer/SDKs/FxPlug.sdk/Library/Frameworks
    - -fmodule-map-file=<PATH_TO_REPO>/DerivedData/Keyframeless/Build/Intermediates.noindex/KeyframelessKit.build/Debug/KeyframelessKit.build/module.modulemap
    - -fmodule-map-file=<PATH_TO_REPO>/DerivedData/Keyframeless/Build/Intermediates.noindex/GeneratedModuleMaps/CocoaLumberjack.modulemap
    - -I<PATH_TO_REPO>/DerivedData/Keyframeless/SourcePackages/checkouts/CocoaLumberjack/Sources/CocoaLumberjack/include
    - -I<PATH_TO_REPO>/KeyframelessKit/KeyframelessKit
    - -I<PATH_TO_REPO>/KeyframelessKit/KeyframelessKit/Metal
    - -I<PATH_TO_REPO>/KeyframelessKit/KeyframelessKit/OSC
    - -I<PATH_TO_REPO>/KeyframelessKit/KeyframelessKit/Plugin
    - -I<PATH_TO_REPO>/KeyframelessKit/KeyframelessKit/Parameter
    - -ferror-limit=0
  
---
# Treat Metal shader files as C++ (closest grammar approximation for clangd formatting).
# Note: actual compilation is handled by Xcode via xcrun metal, not clangd.
If:
  PathMatch: .*\.metal
CompileFlags:
  Add:
    - -x
    - c++
    - -std=c++17
Diagnostics:
  Suppress: "*"

# Setup: run ./scripts/gen-clangd.sh
#
# That generates a complete .clangd for your clone: every header directory (the
# kit now lives in many subfolders), the kit VFS overlay (so <KeyframelessKit/X.h>
# and the quoted "X.h" resolve to the SAME source file instead of redefining), and
# a per-plugin scope block (so the 4 copies of Plugin.h / Constants.h across plugins
# don't collide). Hand-maintaining the -I list below is no longer practical, which
# is why this template drifted out of date. Re-run the script after moving files.
#
# (This template is kept only as a reference for the flag shape.)
