    "On-screen controls show in the viewer only where the property is <accent>constant</accent> or on a <accent>keypose</accent>.": {
      "comment": "OSC guide: closing note on viewer OSC visibility.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Screen-Steuerelemente erscheinen im Viewer nur dort, wo die Eigenschaft <accent>konstant</accent> ist oder auf einer <accent>Keypose</accent> liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles en pantalla solo aparecen en el visor donde la propiedad es <accent>constante</accent> o está en una <accent>pose clave</accent>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes à l'écran n'apparaissent dans le visualiseur que là où la propriété est <accent>constante</accent> ou sur une <accent>pose clé</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンスクリーンコントロールは、プロパティが<accent>一定</accent>の場所か<accent>キーポーズ</accent>上でのみビューアに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤은 속성이 <accent>일정한</accent> 곳이나 <accent>키포즈</accent>에서만 뷰어에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕控件仅在属性<accent>恒定</accent>或位于<accent>关键姿势</accent>处时才显示在检视器中。"
          }
        }
      }
    },
