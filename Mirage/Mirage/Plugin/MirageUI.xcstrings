            "value": "Mezcla de a a b a medida que t va de 0 a 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fond de a à b à mesure que t va de 0 à 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "t が 0 から 1 に進むにつれて a から b へ補間します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "t 가 0에서 1로 갈 때 a 에서 b 로 섞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随着 t 从 0 到 1，从 a 混合到 b。"
          }
        }
      }
    },
