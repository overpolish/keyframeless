    "Mesh": {
      "comment": "Help section title (the plugin name).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
