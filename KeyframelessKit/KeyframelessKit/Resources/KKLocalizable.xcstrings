          "stringUnit": {
            "state": "translated",
            "value": "在此添加关键姿势"
          }
        }
      }
    },
    "Add keyposes anywhere and shape transitions per property": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyposes überall hinzufügen und Übergänge pro Eigenschaft gestalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des poses clés où vous voulez et façonnez les transitions par propriété"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade poses clave donde quieras y da forma a las transiciones por propiedad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにでもキーポーズを追加し、プロパティごとにトランジションを調整"
