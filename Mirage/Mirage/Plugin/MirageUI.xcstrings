          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle « %@ » : un contrôle dans `#slots` a besoin de {n} dans son label et dans le nom de son puck"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロール「%@」: `#slots` 内のコントロールはラベルとパック名に {n} が必要です"
