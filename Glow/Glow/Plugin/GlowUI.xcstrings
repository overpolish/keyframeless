            "value": "Raccourcis des contrôles à l'écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンスクリーンコントロールのショートカット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤 단축키"
          }
        },
        "zh-Hans": {
          "stringUnit": {
