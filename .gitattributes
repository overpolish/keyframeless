# The changelog/update site HTML is generated by Legacy/scripts/build-changelog.py from
# Legacy/docs/changelog/*.md + Legacy/docs/assets/. Mark it generated so GitHub collapses it in
# diffs and excludes it from language stats. Edit the Markdown, not the HTML.
Legacy/docs/**/*.html linguist-generated=true

# Motion templates are generated by scripts/motion-template.py from the plug-in's
# registered parameters and the skeleton in scripts/templates. Edit those, not the
# document.
*/Template/*.moef linguist-generated=true
