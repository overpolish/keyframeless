{
  "sourceLanguage": "en",
  "strings": {
    "Auto-select layers": {
      "comment": "Companion-panel toggle: click a layer in the viewer to select it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebenen automatisch auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección automática de capas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection automatique des calques"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーを自動選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 자동 선택"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择图层"
          }
        }
      }
    },
    "Click a layer in the viewer to select it.": {
      "comment": "Tooltip for the Auto-select layers toggle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Viewer auf eine Ebene, um sie auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una capa del visor para seleccionarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un calque dans le visualiseur pour le sélectionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューアでレイヤーをクリックして選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰어에서 레이어를 클릭하여 선택합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在检视器中点按图层以将其选中。"
          }
        }
      }
    },
