    "Click the <accent>curve</accent> button to animate <warn>Draw On End</warn> - that's what draws the line on.": {
      "comment": "Arrow guide: add Draw On End to animated.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Schaltfläche <accent>Kurve</accent>, um <warn>Zeichnen Ende</warn> zu animieren - das lässt die Linie entstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón <accent>curva</accent> para animar <warn>Dibujar fin</warn>: eso hace que la línea se dibuje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur le bouton <accent>courbe</accent> pour animer <warn>Tracé fin</warn> - c'est ce qui fait apparaître la ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>カーブ</accent>ボタンをクリックして<warn>描画終了</warn>をアニメートします。これで線が描かれていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>곡선</accent> 버튼을 클릭해 <warn>그리기 끝</warn>을 애니메이션합니다. 이것이 선을 그려지게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击<accent>曲线</accent>按钮为<warn>绘制终点</warn>添加动画--它让线条逐渐画出。"
          }
        }
      }
    },
    "Click the <accent>first keypose</accent> to set where the line begins.": {
      "comment": "Arrow guide: click the T=0 keypose.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die <accent>erste Keypose</accent>, um festzulegen, wo die Linie beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la <accent>primera pose clave</accent> para definir dónde empieza la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur la <accent>première pose clé</accent> pour définir où la ligne commence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>最初のキーポーズ</accent>をクリックして、線の開始位置を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<accent>첫 번째 키포즈</accent>를 클릭해 선이 시작되는 위치를 설정합니다."
          }
        },
        "zh-Hans": {
