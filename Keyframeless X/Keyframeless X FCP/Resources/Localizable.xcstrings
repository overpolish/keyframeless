        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューは中央揃えのテンプレートを前提としています。中央揃えでないテンプレートでは位置が異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기는 가운데 정렬 템플릿을 기준으로 합니다. 가운데 정렬이 아닌 템플릿에서는 위치가 다를 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
