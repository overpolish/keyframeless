    "Each row is a property - drop keyposes anywhere on the timeline and shape transitions independently": {
      "comment": "Advanced timing guide: explains the per-property lanes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
