  "strings" : {
    "Animate the clip sliding in from off the left edge to the centre over the first second." : {
      "comment" : "AI example value: slide in from the left.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Animiere den Clip so, dass er in der ersten Sekunde vom linken Rand herein zur Mitte gleitet." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Anima el clip deslizándose desde fuera del borde izquierdo hasta el centro durante el primer segundo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Animez le plan pour qu'il glisse depuis l'extérieur du bord gauche jusqu'au centre pendant la première seconde." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初の1秒間で、クリップが左端の外から中央へスライドして入ってくるようにアニメーションさせる。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 1초 동안 클립이 왼쪽 가장자리 바깥에서 중앙으로 슬라이드해 들어오도록 애니메이션합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让片段在第一秒内从左边缘外滑入到中心。" } }
