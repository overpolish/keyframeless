    "The controls are on the <accent>mini viewer</accent> too. Click a keypose to open it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuerelemente sind auch im <accent>Mini-Viewer</accent>. Klicken Sie auf eine Keypose, um ihn zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes sont aussi dans la <accent>mini-visionneuse</accent>. Cliquez sur une pose clé pour l'ouvrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles también están en el <accent>mini-visor</accent>. Haz clic en una pose clave para abrirlo."
          }
        },
        "ja": {
