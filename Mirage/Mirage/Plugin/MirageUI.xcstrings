    "`#%@` can't set a group: audio and gradients have their own": {
      "comment": "Mirage group-on-dedicated-directive validation error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@` kann keine Gruppe setzen: Audio und Verläufe haben ihre eigene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@` no puede definir un grupo: el audio y los degradados tienen el suyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@` ne peut pas définir de groupe : l'audio et les dégradés ont le leur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@` はグループを指定できません。オーディオとグラデーションには専用のグループがあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@`은(는) 그룹을 설정할 수 없습니다. 오디오와 그라디언트에는 전용 그룹이 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#%@` 无法设置分组：音频和渐变有各自的分组"
          }
        }
      }
    },
    "`#bool` default=%@ isn't on or off - write true/false, yes/no, on/off, or 1/0": {
      "comment": "Mirage bool-default validation error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool` default=%@ ist weder an noch aus – schreibe true/false, yes/no, on/off oder 1/0"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool` default=%@ no es ni activado ni desactivado: escribe true/false, yes/no, on/off o 1/0"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool` default=%@ n'est ni activé ni désactivé : écrivez true/false, yes/no, on/off ou 1/0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool` の default=%@ はオンでもオフでもありません。true/false、yes/no、on/off、1/0 のいずれかで書いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool`의 default=%@는 켜짐도 꺼짐도 아닙니다. true/false, yes/no, on/off 또는 1/0으로 작성하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#bool` 的 default=%@ 既不是开也不是关，请写 true/false、yes/no、on/off 或 1/0"
          }
        }
      }
    },
    "`#multi` takes at most 4 fields - split it into two controls": {
      "comment": "Mirage too-many-multi-fields validation error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi` erlaubt höchstens 4 Felder – teile es in zwei Steuerungen auf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi` admite 4 campos como máximo: divídelo en dos controles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi` accepte 4 champs au maximum : divisez-le en deux contrôles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi` のフィールドは最大 4 つです。2 つのコントロールに分けてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi`는 필드를 최대 4개까지 사용할 수 있습니다. 두 개의 컨트롤로 나누세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`#multi` 最多支持 4 个字段，请拆分为两个控件"
          }
        }
      }
    },
