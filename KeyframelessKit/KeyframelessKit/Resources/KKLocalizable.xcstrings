    "Basic timing has three phases: <accent>In</accent>, <accent>Hold</accent>, <accent>Out</accent>.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfaches Timing hat drei Phasen: <accent>Ein</accent>, <accent>Halten</accent>, <accent>Aus</accent>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le timing basique comporte trois phases : <accent>Entrée</accent>, <accent>Maintien</accent>, <accent>Sortie</accent>."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El timing básico tiene tres fases: <accent>Entrada</accent>, <accent>Mantener</accent>, <accent>Salida</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的なタイミングには3つのフェーズがあります：<accent>イン</accent>、<accent>ホールド</accent>、<accent>アウト</accent>。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 타이밍에는 세 가지 단계가 있습니다: <accent>인</accent>, <accent>유지</accent>, <accent>아웃</accent>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本时间控制有三个阶段：<accent>进入</accent>、<accent>保持</accent>、<accent>退出</accent>。"
          }
        }
      },
      "comment": "Timing guide: the three Basic phases."
    },
