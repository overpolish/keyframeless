    "Drag <warn>Draw On End</warn> down to <warn>0</warn> so the line starts undrawn.": {
      "comment": "Arrow guide: drag the start value to 0.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe <warn>Zeichnen Ende</warn> auf <warn>0</warn> herunter, damit die Linie ungezeichnet beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra <warn>Dibujar fin</warn> hasta <warn>0</warn> para que la línea empiece sin dibujar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser <warn>Tracé fin</warn> jusqu'à <warn>0</warn> pour que la ligne commence non tracée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>描画終了</warn>を<warn>0</warn>までドラッグして、線が未描画の状態から始まるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<warn>그리기 끝</warn>을 <warn>0</warn>까지 끌어내려 선이 그려지지 않은 상태에서 시작하도록 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将<warn>绘制终点</warn>拖到<warn>0</warn>，让线条从未绘制状态开始。"
          }
        }
      }
    },
    "Drag Position, Scale and Rotation right on the preview with their on-screen handles, or type exact numbers in the inspector.": {
      "comment": "Canvas help tip (from AIKnowledge markdown).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Position, Skalieren und Rotation direkt in der Vorschau an ihren Bildschirmgriffen, oder gib genaue Zahlen im Inspektor ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra Posición, Escala y Rotación directamente en la previsualización con sus tiradores en pantalla, o escribe números exactos en el inspector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser Position, Échelle et Rotation directement sur l'aperçu à l'aide de leurs poignées à l'écran, ou saisissez des valeurs précises dans l'inspecteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置・スケール・回転は、画面上のハンドルを使ってプレビュー上で直接ドラッグするか、インスペクタに正確な数値を入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치, 크기 조절, 회전은 화면의 핸들로 미리보기에서 바로 드래그하거나 인스펙터에 정확한 숫자를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用屏幕上的手柄直接在预览中拖动位置、缩放和旋转，或在检查器中输入精确数值。"
          }
        }
      }
    },
