        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个控件都有一个重置箭头，当数值与默认值不同时会出现。"
          }
        }
      }
    },
    "Each row is a property. Drop <accent>keyposes</accent> anywhere and shape each interval independently.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
