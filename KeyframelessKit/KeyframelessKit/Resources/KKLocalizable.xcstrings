      }
    },
    "Your current sequence isn't compatible with Basic mode.": {
      "comment": "Alert message when switching timeline to Basic mode.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Sequenz ist nicht mit dem einfachen Modus kompatibel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu secuencia actual no es compatible con el modo Básico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séquence actuelle n’est pas compatible avec le mode Basique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のシーケンスは基本モードと互換性がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시퀀스는 기본 모드와 호환되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前序列与基本模式不兼容。"
          }
        }
      }
    },
    "Zoom out to see the <accent>other keyposes</accent>.": {
      "comment": "Mini-viewer guide: zoom out across the filmstrip.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomen Sie heraus, um die <accent>anderen Keyposes</accent> zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aleja el zoom para ver las <accent>otras poses clave</accent>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dézoomez pour voir les <accent>autres poses clés</accent>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームアウトして<accent>他のキーポーズ</accent>を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소하여 <accent>다른 키포즈</accent>를 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小以查看<accent>其他关键姿势</accent>。"
          }
        }
      }
    },
