    "Click the <warn>gap</warn> between keyposes to change its easing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf die <warn>Lücke</warn> zwischen Keyposes, um deren Easing zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l'<warn>intervalle</warn> entre les poses clés pour changer son accélération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el <warn>intervalo</warn> entre poses clave para cambiar su suavizado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーポーズ間の<warn>ギャップ</warn>をクリックして、イージングを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키포즈 사이의 <warn>간격</warn>을 클릭하여 이징을 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击关键姿势之间的<warn>间隙</warn>来更改其缓动。"
          }
        }
      },
      "comment": "Timing guide: click a gap to edit easing."
    },
