    "Each row is a property — drop keyposes anywhere on the timeline and shape transitions independently": {
      "comment": "Advanced timing guide: explains the per-property lanes.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile ist eine Eigenschaft — setze Keyposes überall auf der Timeline und gestalte Übergänge unabhängig"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行代表一个属性——在时间线上的任意位置放置关键姿势，并独立塑造过渡"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne est une propriété — déposez des poses clés où vous voulez sur la timeline et façonnez les transitions indépendamment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行が 1 つのプロパティです。タイムライン上の任意の場所にキーポーズを配置し、トランジションを個別に調整できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 행은 하나의 속성입니다. 타임라인 어디에나 키포즈를 놓고 전환을 독립적으로 조정하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fila es una propiedad: coloca poses clave donde quieras en la línea de tiempo y da forma a las transiciones de forma independiente"
          }
        }
      }
    },
    "Edit non-animating values in the mini-canvas": {
