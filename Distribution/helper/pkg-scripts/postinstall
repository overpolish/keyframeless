#
# Bootstrap the on-demand local-AI LaunchAgent for the logged-in user so it's active
# immediately (without a logout). The plist lives in /Library/LaunchAgents, so it also
# auto-loads for every user at their next login; this just avoids the wait for the
# person installing right now. On-demand (MachServices, no RunAtLoad) means nothing
# runs until a plugin actually asks for local inference.

set -e

LABEL="co.overpolish.keyframeless.aihelper"
PLIST="/Library/LaunchAgents/$LABEL.plist"

CONSOLE_USER=$(stat -f "%Su" /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ -f "$PLIST" ]; then
	USER_UID=$(id -u "$CONSOLE_USER")
	# Unregister any prior job (bootout SIGTERMs it) then FORCE-kill any survivor.
	# On an update the new binary is already on disk, but a helper wedged in MLX
	# compute (holding many GB) can ignore/lag SIGTERM - it must be gone before the
	# fresh binary serves the next request, or the stale process keeps answering.
	launchctl bootout "gui/$USER_UID/$LABEL" 2>/dev/null || true
	pkill -TERM -f 'Keyframeless/kk-ai-helper' 2>/dev/null || true
	for _ in 1 2 3 4 5; do
		pgrep -f 'Keyframeless/kk-ai-helper' >/dev/null 2>&1 || break
		sleep 0.3
	done
	pkill -KILL -f 'Keyframeless/kk-ai-helper' 2>/dev/null || true
	# Re-register the (new) binary into the user's GUI domain.
	launchctl bootstrap "gui/$USER_UID" "$PLIST" 2>/dev/null || true
fi

exit 0
