        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在<accent>高亮区域</accent>中开始拖动并向右移动，框选多个关键姿势。"
          }
        }
      }
    },
    "Switch a control <warn>off</warn> to hide just that one.": {
      "comment": "OSC guide: toggle a per-element pill off.",
      "extractionState": "manual",
      "localizations": {
        "de": {
