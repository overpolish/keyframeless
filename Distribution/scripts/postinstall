#!/bin/bash

CURRENT_USER=$(stat -f "%Su" /dev/console)
USER_HOME=$(eval echo ~$CURRENT_USER)
MOTION_TEMPLATES_BASE="$USER_HOME/Movies/Motion Templates.localized"
FOUND_TEMPLATES=0

# Works with any plugin by copying across correct motion template tree
for TEMPLATE_TYPE_DIR in Effects.localized Generators.localized Titles.localized Transitions.localized; do
    if [ -d "./$TEMPLATE_TYPE_DIR" ]; then
        DEST_DIR="$MOTION_TEMPLATES_BASE/$TEMPLATE_TYPE_DIR"
        mkdir -p "$DEST_DIR"
        chown "$CURRENT_USER:staff" "$MOTION_TEMPLATES_BASE"
        chown "$CURRENT_USER:staff" "$DEST_DIR"
        cp -R "./$TEMPLATE_TYPE_DIR/"* "$DEST_DIR/"
        chown -R "$CURRENT_USER:staff" "$DEST_DIR"
        FOUND_TEMPLATES=1
    fi
done

# Install the uninstall script alongside the app, named for the product. Per-product
# builds carry a `PLUGIN="..."` line; the suite bundle's uninstall has none, so it
# falls back to "Keyframeless".
SCRIPT_DIR="$(dirname "$0")"
UNINSTALL=$(ls "$SCRIPT_DIR"/uninstall* 2>/dev/null | head -1)
if [ -n "$UNINSTALL" ] && [ -d "$2" ]; then
    PLUGIN_NAME=$(sed -n 's/^PLUGIN="\(.*\)"$/\1/p' "$UNINSTALL" | head -1)
    [ -z "$PLUGIN_NAME" ] && PLUGIN_NAME="Keyframeless"
    cp "$UNINSTALL" "$2/Uninstall $PLUGIN_NAME"
    chmod +x "$2/Uninstall $PLUGIN_NAME"
fi

exit 0