        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Eigenschaft hat zwei Timing-Modi, umgeschaltet mit der Pille oben in ihrer Zeile:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada propiedad tiene dos modos de temporización, que se alternan con la píldora en la parte superior de su fila:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque propriété a deux modes de minutage, basculés avec la pilule en haut de sa ligne :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロパティには2つのタイミングモードがあり、行の上部のピルで切り替えます:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 속성에는 두 가지 타이밍 모드가 있으며, 행 상단의 알약으로 전환합니다:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个属性都有两种时间控制模式，用其行顶部的胶囊开关切换："
          }
        }
      }
    },
