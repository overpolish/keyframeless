    "Switching will reset incompatible lanes.": {
      "comment": "Alert detail when switching timeline to Basic mode.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechseln werden inkompatible Spuren zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar se restablecerán las pistas incompatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement réinitialisera les pistes incompatibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えると互換性のないレーンがリセットされます。"
          }
