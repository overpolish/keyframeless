{
  "sourceLanguage": "en",
  "strings": {
    "Shimmer": {
      "comment": "Built-in preset name: drifting noise grain + radial gradient shimmer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimmern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centelleo"
          }
        },
        "fr": {
