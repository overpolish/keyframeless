          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono muestreado en grados, en la convención propia de este control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La teinte prélevée en degrés, selon la convention de ce réglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプリングした色相を度数で、このコントロール自身の表記で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플링한 색조를 도 단위로, 이 컨트롤 자체의 표기로 기록합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
