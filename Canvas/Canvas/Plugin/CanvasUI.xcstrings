    "Fade every layer's opacity up from 0 to 100 over the first half second.": {
      "comment": "AI example value: fade everything in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende die Deckkraft jeder Ebene in der ersten halben Sekunde von 0 auf 100 hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la opacidad de cada capa de 0 a 100 durante el primer medio segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez l'opacité de chaque calque de 0 à 100 pendant la première demi-seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の0.5秒で各レイヤーの不透明度を0から100まで上げて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 0.5초 동안 각 레이어의 불투명도를 0에서 100까지 올려 줘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最初的半秒内将每个图层的不透明度从 0 提升到 100。"
          }
        }
      }
    },
