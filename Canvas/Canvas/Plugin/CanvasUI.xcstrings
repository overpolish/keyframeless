          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスを描き、矢印を追加して、描かれる様子をアニメートします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스를 그리고 화살표를 추가한 뒤 그려지는 모습을 애니메이션합니다"
          }
