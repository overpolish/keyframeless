#
# Removes the shared local-AI engine. Downloaded models are left in place (user data
# in the app-group container); delete that folder by hand if you want the space back:
#   ~/Library/Group Containers/group.co.overpolish.keyframeless/huggingface
#
# Installed at /Applications/Keyframeless/Uninstall Keyframeless AI (alongside the
# plugins) so it's easy to find.

LABEL="co.overpolish.keyframeless.aihelper"
UID_NUM="$(id -u)"
ENGINE="/Library/Application Support/Keyframeless"
PLIST="/Library/LaunchAgents/$LABEL.plist"
SELF="/Applications/Keyframeless/Uninstall Keyframeless AI"

echo "Keyframeless AI Uninstaller"
echo "=============================="
echo ""
echo "Removes the shared on-device AI engine. Your plugins keep working with"
echo "remote (BYOK) AI. Downloaded models are left in place."
echo ""

echo "The following will be deleted:"
[ -e "$ENGINE" ] && echo "  $ENGINE"
[ -e "$PLIST" ] && echo "  $PLIST"
if [ ! -e "$ENGINE" ] && [ ! -e "$PLIST" ]; then
    echo "  (nothing - Keyframeless AI is already uninstalled)"
    sleep 2
    osascript -e 'tell application "Terminal" to close front window' &
    exit 0
fi
echo ""

read -p "Continue? (y/n) " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Uninstall cancelled."
    exit 0
fi

launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null || true
sudo rm -f "$PLIST"
sudo rm -rf "$ENGINE"

# Drop this uninstaller, then the /Applications/Keyframeless folder if no plugins left.
sudo rm -f "$SELF"
sudo rmdir "/Applications/Keyframeless" 2>/dev/null || true

echo ""
echo "Keyframeless AI uninstalled. Plugins fall back to remote (BYOK) AI."
sleep 2
osascript -e 'tell application "Terminal" to close front window' &
