          }
        }
      }
    },
    "Curve the path and scale a keypose": {
      "comment": "Help guide subtitle: Shaping a Move.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Pfad kurven und eine Keypose skalieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courber la trajectoire et mettre une pose clé à l'échelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva la trayectoria y escala una pose clave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスをカーブさせ、キーポーズをスケールする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로를 곡선으로 만들고 키포즈 크기 조절하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弯曲路径并缩放关键姿势"
          }
        }
      }
    },
    "Guides are disabled. Click the effect's header on a clip to select it (it highlights yellow), then move your mouse over the viewer to enable them.": {
      "comment": "Help guide disabled subtitle (no OSC canvas reference yet).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anleitungen sind deaktiviert. Klicken Sie auf die Kopfzeile des Effekts in einem Clip, um ihn auszuwählen (er wird gelb hervorgehoben), und bewegen Sie dann die Maus über den Viewer, um sie zu aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guides sont désactivés. Cliquez sur l'en-tête de l'effet sur un plan pour le sélectionner (il apparaît en jaune), puis placez le pointeur sur le visualiseur pour les activer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las guías están desactivadas. Haz clic en el encabezado del efecto en un clip para seleccionarlo (se resalta en amarillo) y luego mueve el ratón sobre el visor para activarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドは無効です。クリップのエフェクトのヘッダをクリックして選択し（黄色でハイライトされます）、ビューアにマウスを移動すると有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드가 비활성화되어 있습니다. 클립에서 이펙트 헤더를 클릭하여 선택하면(노란색으로 강조 표시됨) 뷰어 위로 마우스를 이동하면 활성화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指南已停用。点击片段上效果的标题来选择它（会以黄色高亮显示），然后将鼠标移到检视器上即可启用。"
          }
        }
      }
    },
    "Magic Move": {
