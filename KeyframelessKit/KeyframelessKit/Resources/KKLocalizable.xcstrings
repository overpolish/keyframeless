            "state": "translated",
            "value": "Réglez une commande sur <warn>arrêt</warn> pour ne masquer que celle-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un control en <warn>apagado</warn> para ocultar solo ese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールを<warn>オフ</warn>にすると、そのコントロールだけ非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤을 <warn>끄면</warn> 해당 컨트롤만 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
