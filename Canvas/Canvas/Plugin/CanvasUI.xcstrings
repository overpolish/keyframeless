    "Draw a path, add an arrow, and animate it drawing on": {
      "comment": "Help guide subtitle: Animating an Arrow.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne einen Pfad, füge einen Pfeil hinzu und animiere sein Entstehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja un trazado, añade una flecha y anima cómo se dibuja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
