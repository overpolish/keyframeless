            "state": "translated",
            "value": "Façonner un mouvement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar forma a un movimiento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動きを形づくる"
          }
