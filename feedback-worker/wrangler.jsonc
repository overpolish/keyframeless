{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keyframeless-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-05-20",
  // No static assets: the form is a page on the site
  // (docs/feedback/index.html). This Worker is only the POST endpoint.
  // Screenshot uploads land here; the form embeds their public URLs in the issue.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "keyframeless-feedback",
      "remote": true,
    },
  ],
  "vars": {
    "GITHUB_REPO": "overpolish/keyframeless",
    // Public base URL of the bucket - the r2.dev URL or a custom domain.
    "R2_PUBLIC_URL": "https://pub-6e8fc2ae5e5249a398c8b3a182dfe768.r2.dev",
  },
  // Secrets - set with `wrangler secret put NAME`, never committed:
  //   TURNSTILE_SECRET   Cloudflare Turnstile secret key
  //   GITHUB_TOKEN       fine-grained PAT, issues:write on GITHUB_REPO only
  // EXACT paths, not /feedback/* - a wildcard would shadow the form page
  // itself, which must keep coming from GitHub Pages. Requires keyframeless.com
  // to be PROXIED through Cloudflare (orange cloud) in front of Pages.
  "routes": [
    { "pattern": "keyframeless.com/feedback/submit", "zone_name": "keyframeless.com" },
    { "pattern": "keyframeless.com/feedback/github-webhook", "zone_name": "keyframeless.com" },
  ],
}
