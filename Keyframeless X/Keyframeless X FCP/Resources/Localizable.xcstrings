    "Preview assumes a center-aligned template. Position may differ with off-center templates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorschau geht von einer zentrierten Vorlage aus. Bei nicht zentrierten Vorlagen kann die Position abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa supone una plantilla centrada. La posición puede variar con plantillas no centradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu suppose un modèle centré. La position peut varier avec des modèles non centrés."
          }
