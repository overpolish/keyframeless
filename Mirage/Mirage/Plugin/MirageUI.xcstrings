        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤 \"%@\": `#slots` 안의 컨트롤은 레이블과 퍽 이름에 {n}이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控件“%@”：`#slots` 内的控件需要在标签和控制柄名称中包含 {n}"
          }
        }
      }
    },
    "With every `#slots` group full this shader asks for %d controls, and %d is the limit - lower a max= or drop a control": {
      "comment": "Mirage slots scalar-pool budget error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit allen `#slots`-Gruppen voll verlangt dieser Shader %d Regler, und %d ist das Limit - senke ein max= oder entferne einen Regler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada grupo `#slots` lleno, este sombreador pide %d controles, y el límite es %d: reduce un max= o elimina un control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec chaque groupe `#slots` au complet, ce shader demande %d commandes, et la limite est %d : réduisez un max= ou supprimez une commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての `#slots` グループを上限まで使うと、このシェーダーは %d 個のコントロールを要求します。上限は %d 個です。max= を下げるかコントロールを減らしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 `#slots` 그룹을 채우면 이 셰이더는 컨트롤 %d개를 요구하며, 한도는 %d개입니다. max= 를 낮추거나 컨트롤을 줄이세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当每个 `#slots` 组都填满时，此着色器需要 %d 个控件，上限为 %d 个：请降低 max= 或删除一个控件"
          }
        }
      }
    },
    "With every `#slots` group full this shader asks for %d colours, and %d is the limit - lower a max= or drop a colour": {
      "comment": "Mirage slots colour-pool budget error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit allen `#slots`-Gruppen voll verlangt dieser Shader %d Farben, und %d ist das Limit - senke ein max= oder entferne eine Farbe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada grupo `#slots` lleno, este sombreador pide %d colores, y el límite es %d: reduce un max= o elimina un color"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec chaque groupe `#slots` au complet, ce shader demande %d couleurs, et la limite est %d : réduisez un max= ou supprimez une couleur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての `#slots` グループを上限まで使うと、このシェーダーは %d 色を要求します。上限は %d 色です。max= を下げるか色を減らしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 `#slots` 그룹을 채우면 이 셰이더는 색상 %d개를 요구하며, 한도는 %d개입니다. max= 를 낮추거나 색상을 줄이세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当每个 `#slots` 组都填满时，此着色器需要 %d 种颜色，上限为 %d 种：请降低 max= 或删除一种颜色"
          }
        }
      }
    },
    "`{n}` only means something inside a `#slots` block": {
      "comment": "Mirage stray slots placeholder error.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
