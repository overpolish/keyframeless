        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que el resplandor pulse haciéndose más grande y volviendo varias veces a lo largo del clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
