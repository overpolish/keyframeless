    "Keep dragging right, past the keyposes, then release.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie weiter nach rechts, über die Keyposes hinaus, und lassen Sie dann los."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à glisser vers la droite, au-delà des poses clés, puis relâchez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue arrastrando a la derecha, más allá de las poses clave, y luego suelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま右へ、キーポーズを越えてドラッグし、放します。"
          }
        },
        "ko": {
