    "Animate the topmost layer sliding in from off the left edge to its place over the first second.": {
      "comment": "AI example value: slide a layer in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiere die oberste Ebene, wie sie in der ersten Sekunde von außerhalb des linken Rands an ihren Platz gleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima la capa superior deslizándose desde fuera del borde izquierdo hasta su posición durante el primer segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animez le calque le plus haut qui glisse depuis l'extérieur du bord gauche jusqu'à sa place pendant la première seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面のレイヤーが最初の1秒間で左端の外から定位置へスライドインするようにアニメーションして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨 위 레이어가 첫 1초 동안 왼쪽 가장자리 바깥에서 제자리로 슬라이드해 들어오도록 애니메이션해 줘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让最上面的图层在第一秒内从左边缘外滑入到它的位置。"
          }
